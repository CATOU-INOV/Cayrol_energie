---
// Hero avec photo détourée par une forme organique (clip-path SVG) plutôt qu'un rectangle classique
// — coins arrondis irréguliers avec un décrochage en haut à droite, façon carte "coin cassé".
// Le path est défini en coordonnées relatives (objectBoundingBox), donc il s'adapte à n'importe
// quel ratio de conteneur sans être recalculé.

// Variantes de découpe disponibles, toutes en coordonnées relatives (objectBoundingBox) donc
// indépendantes du ratio du conteneur. Chaque variante retire un rectangle d'un coin de l'image
// (encoche nette, façon carte "coin cassé") ; le logo est ensuite positionné en absolute dans cet
// espace vide dégagé par l'encoche, jamais superposé à la photo.
// notch (hydro) est en coordonnées relatives (objectBoundingBox) — path d'origine inchangé.
// chamfer/step sont en coordonnées absolues du viewBox (userSpaceOnUse, 100x40) car plus simple
// à raisonner pour composer des coins arrondis (rayon ~4 unités, cohérent avec les rayons de
// l'ordre de 3-5% de largeur du path notch).
const CLIP_PATHS = {
  // Hydro : coins arrondis irréguliers + décrochage en haut à droite (path d'origine, inchangé).
  notch: "M0.0998072 1H0.422076H0.749756C0.767072 1 0.774207 0.961783 0.77561 0.942675V0.807325C0.777053 0.743631 0.791844 0.731953 0.799059 0.734076H0.969813C0.996268 0.730255 1.00088 0.693206 0.999875 0.675159V0.0700637C0.999875 0.0254777 0.985045 0.00477707 0.977629 0H0.902473C0.854975 0 0.890448 0.138535 0.850165 0.138535H0.0204424C0.00408849 0.142357 0 0.180467 0 0.199045V0.410828C0 0.449045 0.0136283 0.46603 0.0204424 0.469745H0.0523086C0.0696245 0.471019 0.0735527 0.497877 0.0733523 0.511146V0.915605C0.0723903 0.983121 0.090588 1 0.0998072 1Z",
  // Biogaz : rectangle à coins arrondis avec une encoche arrondie en bas à gauche.
  chamfer:
    "M4,0 H96 C98.2,0 100,1.8 100,4 V36 C100,38.2 98.2,40 96,40 H32.5 C30.3,40 28.5,38.2 28.5,36 V28 C28.5,25.8 26.7,24 24.5,24 H4 C1.8,24 0,22.2 0,20 V4 C0,1.8 1.8,0 4,0 Z",
  // Flexibilité/BESS : rectangle à coins arrondis avec une encoche arrondie en haut à gauche.
  step: "M24.5,4 C24.5,1.8 26.3,0 28.5,0 H96 C98.2,0 100,1.8 100,4 V36 C100,38.2 98.2,40 96,40 H4 C1.8,40 0,38.2 0,36 V16 C0,13.8 1.8,12 4,12 H20.5 C22.7,12 24.5,10.2 24.5,8 Z",
} as const;

type ClipVariant = keyof typeof CLIP_PATHS;
const CLIP_UNITS: Record<ClipVariant, "objectBoundingBox" | "userSpaceOnUse"> = {
  notch: "objectBoundingBox",
  chamfer: "userSpaceOnUse",
  step: "userSpaceOnUse",
};

// Position du logo dans l'espace vide dégagé par l'encoche de chaque variante.
const LOGO_POSITION: Record<ClipVariant, string> = {
  notch: "right-6 bottom-4",
  chamfer: "left-2 bottom-2 md:left-4 md:bottom-4",
  step: "left-2 top-2 md:left-4 md:top-4",
};

interface Props {
  src: string;
  alt: string;
  class?: string;
  /** Logo affiché dans l'espace dégagé par l'encoche (position dépendante de la variante). */
  logo?: string;
  /** Silhouette de découpe. "notch" (défaut, hydro, encoche haut-droite) | "chamfer" (biogaz, bas-gauche) | "step" (flexibilité/BESS, haut-gauche). */
  variant?: ClipVariant;
}

const { src, alt, class: className = "", logo, variant = "notch" } = Astro.props;

// Identifiant unique du clipPath pour permettre plusieurs instances sur une même page sans
// collision d'id SVG (chaque appel du composant obtient son propre id).
const clipId = `organic-clip-${Math.random().toString(36).slice(2, 9)}`;
const logoPosition = LOGO_POSITION[variant];
const clipUnits = CLIP_UNITS[variant];
---

<figure class={`relative m-0 ${className}`}>
  <svg class="block h-full w-full" viewBox="0 0 100 40" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <clipPath id={clipId} clipPathUnits={clipUnits}>
        <path d={CLIP_PATHS[variant]}></path>
      </clipPath>
    </defs>
    <image
      href={src}
      clip-path={`url(#${clipId})`}
      preserveAspectRatio="xMidYMid slice"
      width="100%"
      height="100%"
    ></image>
  </svg>
  {logo && (
    <img
      src={logo}
      alt=""
      class={`hero-logo absolute ${logoPosition} h-14 w-14 object-contain md:h-20 md:w-20`}
    />
  )}
  <span class="sr-only">{alt}</span>
</figure>
