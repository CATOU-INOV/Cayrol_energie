---
// Hero avec photo détourée (clip-path SVG) plutôt qu'un rectangle classique, façon carte
// "coin cassé".

// Variantes de découpe disponibles. Chaque variante retire un rectangle d'un coin de l'image
// (encoche arrondie) ; le logo est ensuite positionné en absolute dans cet espace vide dégagé par
// l'encoche, jamais superposé à la photo.
// Toutes en coordonnées absolues du viewBox (userSpaceOnUse, 100x40), plus simple à raisonner
// pour composer des coins arrondis (rayon ~4 unités). Retour client : un cadre simple commun aux
// pages métiers, avec l'encoche (donc le logo) dans un coin différent pour chaque énergie.
const CLIP_PATHS = {
  // Hydro : rectangle à coins arrondis avec une encoche arrondie en haut à droite.
  corner:
    "M4,0 H71.5 C73.7,0 75.5,1.8 75.5,4 V8 C75.5,10.2 77.3,12 79.5,12 H96 C98.2,12 100,13.8 100,16 V36 C100,38.2 98.2,40 96,40 H4 C1.8,40 0,38.2 0,36 V4 C0,1.8 1.8,0 4,0 Z",
  // Biogaz : rectangle à coins arrondis avec une encoche arrondie en bas à gauche.
  chamfer:
    "M4,0 H96 C98.2,0 100,1.8 100,4 V36 C100,38.2 98.2,40 96,40 H32.5 C30.3,40 28.5,38.2 28.5,36 V28 C28.5,25.8 26.7,24 24.5,24 H4 C1.8,24 0,22.2 0,20 V4 C0,1.8 1.8,0 4,0 Z",
  // Photovoltaïque : rectangle à coins arrondis avec une encoche arrondie en bas à droite.
  tab: "M96,0 H4 C1.8,0 0,1.8 0,4 V36 C0,38.2 1.8,40 4,40 H67.5 C69.7,40 71.5,38.2 71.5,36 V28 C71.5,25.8 73.3,24 75.5,24 H96 C98.2,24 100,22.2 100,20 V4 C100,1.8 98.2,0 96,0 Z",
  // Flexibilité/BESS : rectangle à coins arrondis avec une encoche arrondie en haut à gauche.
  step: "M24.5,4 C24.5,1.8 26.3,0 28.5,0 H96 C98.2,0 100,1.8 100,4 V36 C100,38.2 98.2,40 96,40 H4 C1.8,40 0,38.2 0,36 V16 C0,13.8 1.8,12 4,12 H20.5 C22.7,12 24.5,10.2 24.5,8 Z",
} as const;

type ClipVariant = keyof typeof CLIP_PATHS;
const CLIP_UNITS: Record<ClipVariant, "objectBoundingBox" | "userSpaceOnUse"> = {
  corner: "userSpaceOnUse",
  chamfer: "userSpaceOnUse",
  step: "userSpaceOnUse",
  tab: "userSpaceOnUse",
};

// Position du logo dans l'espace vide dégagé par l'encoche de chaque variante.
const LOGO_POSITION: Record<ClipVariant, string> = {
  corner: "right-2 top-2 md:right-4 md:top-4",
  chamfer: "left-2 bottom-2 md:left-4 md:bottom-4",
  step: "left-2 top-2 md:left-4 md:top-4",
  tab: "right-2 bottom-2 md:right-4 md:bottom-4",
};

interface Props {
  src: string;
  alt: string;
  class?: string;
  /** Logo affiché dans l'espace dégagé par l'encoche (position dépendante de la variante). */
  logo?: string;
  /** Silhouette de découpe. "corner" (défaut, hydro, haut-droite) | "chamfer" (biogaz, bas-gauche) | "step" (flexibilité/BESS, haut-gauche) | "tab" (photovoltaïque, bas-droite). */
  variant?: ClipVariant;
}

const { src, alt, class: className = "", logo, variant = "corner" } = Astro.props;

// Identifiant unique du clipPath pour permettre plusieurs instances sur une même page sans
// collision d'id SVG (chaque appel du composant obtient son propre id).
const clipId = `organic-clip-${Math.random().toString(36).slice(2, 9)}`;
const logoPosition = LOGO_POSITION[variant];
const clipUnits = CLIP_UNITS[variant];
---

<figure class={`relative m-0 ${className}`}>
  <svg class="block h-full w-full" viewBox="0 0 100 40" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <clipPath id={clipId} clipPathUnits={clipUnits}>
        <path d={CLIP_PATHS[variant]}></path>
      </clipPath>
    </defs>
    <image
      href={src}
      clip-path={`url(#${clipId})`}
      preserveAspectRatio="xMidYMid slice"
      width="100%"
      height="100%"
    ></image>
  </svg>
  {logo && (
    <img
      src={logo}
      alt=""
      class={`hero-logo absolute ${logoPosition} h-14 w-14 object-contain md:h-20 md:w-20`}
    />
  )}
  <span class="sr-only">{alt}</span>
</figure>
