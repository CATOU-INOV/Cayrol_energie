---
import BaseLayout from "../layouts/BaseLayout.astro";
import AnimatedHero from "../components/AnimatedHero.astro";
import OrganicImageHero from "../components/OrganicImageHero.astro";
import ThematicTab from "../components/ThematicTab.tsx";
import HydroStacks from "../components/HydroStacks.astro";
import ProjectScrollShowcase from "../components/ProjectScrollShowcase.astro";
import { themes } from "../data/themes";
import { photoUrl } from "../data/photos";
import projects from "../data/projects.json";

const theme = themes.hydroelectricite;

// 2 projets phares demandés par le client (un haute chute, un basse chute). Un seul projet hydro
// référencé dans les données actuelles (La Combe, site hybride hydro + solaire).
// TODO-CONTENT : demander au client ses 2 centrales phares (une haute chute, une basse chute) avec
// photos, et préciser la famille de La Combe (Montartier).
const laCombe = projects.find((p) => p.id === "la-combe")!;
const featuredProjects = [
  {
    name: laCombe.name,
    type: "Hydroélectricité + toiture solaire",
    commune: laCombe.commune,
    power: laCombe.power,
    description: laCombe.description,
    image: photoUrl("hydroBasseChute", { w: 900 }),
  },
  {
    name: "Centrale haute chute",
    type: "Centrale haute chute",
    commune: "TODO-CONTENT",
    power: "—",
    description: "TODO-CONTENT : projet haute chute phare à fournir par le client (nom, commune, puissance, courte description, photo).",
    image: photoUrl("hydroHauteChute", { w: 900 }),
  },
];
---

<BaseLayout title="Hydroélectricité" theme="hydroelectricite">
  <!-- Hero sticky : le titre se colore mot par mot et le logo tourne au fil du scroll, scroll
       retenu (wheel intercepté) tant que la coloration n'est pas terminée — cf. AnimatedHero.astro
       pour le détail du mécanisme (extrait de ce hero pour être réutilisé sur biogaz/BESS). -->
  <AnimatedHero
    heroId="hydro-hero"
    eyebrow={theme.name}
    title="Un savoir-faire historique au fil de l'eau."
    color={theme.color}
  >
    <Fragment slot="lead">
      <p class="mt-4 text-sm leading-relaxed text-slate-600 md:text-base">
        Pionnier de la production hydroélectrique, Cayrol Energie exploite aujourd'hui 11 centrales pour une
        puissance cumulée de 19,15 MW, un savoir-faire transmis depuis plusieurs générations.
      </p>

      <div class="mt-8 flex flex-col gap-5">
        <div>
          <p class="text-3xl font-extrabold" style={`color:${theme.color}`} data-countup="11">11</p>
          <p class="text-sm text-slate-500">centrales hydroélectriques</p>
        </div>
        <div>
          <p class="text-3xl font-extrabold" style={`color:${theme.color}`} data-countup="19.15" data-decimals="2" data-suffix=" MW">19,15 MW</p>
          <p class="text-sm text-slate-500">de puissance installée</p>
        </div>
        <div>
          <p class="text-3xl font-extrabold" style={`color:${theme.color}`} data-countup="4">4</p>
          <p class="text-sm text-slate-500">générations au fil de l'eau</p>
        </div>
      </div>
    </Fragment>

    <OrganicImageHero
      slot="image"
      src={photoUrl("hydroHauteChute", { w: 1800 })}
      alt="Barrage hydroélectrique en montagne"
      logo={theme.logo}
      variant="corner"
      class="h-[340px] w-full sm:h-[420px] md:h-[520px] lg:h-[min(680px,calc(100vh-var(--header-h,61px)-4rem))]"
    />
  </AnimatedHero>

  <section class="bg-white">
  <div class="mx-auto max-w-7xl px-4 pb-14">
    <ThematicTab
      client:visible
      color={theme.color}
      explanations={[
        {
          title: "Historique",
          body: "TODO-CONTENT : retracer l'historique familial de l'activité hydroélectrique (dates de reprise/construction des premières centrales, ancienneté du savoir-faire, texte à fournir ou valider par le client.",
        },
        {
          title: "Expérience",
          body: "TODO-CONTENT : détailler l'expérience technique (types de turbines, gammes de puissance maîtrisées, zones géographiques d'intervention), texte provisoire à valider par le client.",
        },
      ]}
    />
  </div>
  </section>

  <HydroStacks color={theme.color} />

  <ProjectScrollShowcase title="Nos centrales phares" color={theme.color} projects={featuredProjects} />
</BaseLayout>
