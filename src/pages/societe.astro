---
import BaseLayout from "../layouts/BaseLayout.astro";
import { themes } from "../data/themes";
import { photoUrl } from "../data/photos";
import projects from "../data/projects.json";
import { partners } from "../data/company";

// Page Société — squelette (retour client) en 5 temps : manifeste, frise des 3 générations,
// deux territoires (73 / 34), valeurs autour du sigle, bandeau de confiance + contact.
// Textes repris du site actuel cayrolenergie.com/societe ; tout ce que ce site ne fournit pas
// (dates, jalons, logos de labels) est marqué d'un badge "À compléter" (classe .todo-badge),
// jamais inventé. TODO-CONTENT : à remplir au fil des retours client.

const theme = themes.societe;
const hydro = themes.hydroelectricite;
const pv = themes.photovoltaique;

// Phrase de la vision Cayrol (site actuel, section "Qui sommes-nous"), colorée mot par mot au
// scroll comme le titre du hero de l'accueil.
const manifeste =
  "La transition énergétique se fera par une production locale, décentralisée, au plus proche du point de consommation.";

// Sigle du hero : 11 pastilles photo sur un cercle (comme les 11 points du logo), taille
// croissante dans le sens horaire. Photos des filières en alternance.
const siglePhotos = [
  photoUrl("hydroHauteChute", { w: 300 }),
  photoUrl("pvToiture", { w: 300 }),
  "/projets/star-soleil/principale.jpg",
  photoUrl("bessTerrain", { w: 300 }),
  photoUrl("hydroBasseChute", { w: 300 }),
  photoUrl("pvOmbrieres", { w: 300 }),
  "/images/biogaz/unite-methanisation.jpg",
  photoUrl("pvAuSol", { w: 300 }),
  photoUrl("hydroHauteChute", { w: 300 }),
  photoUrl("pvAgrivoltaisme", { w: 300 }),
  photoUrl("pvToiture", { w: 300 }),
];
const sigleDots = siglePhotos.map((photo, i) => {
  const angle = ((-90 + (i * 360) / siglePhotos.length) * Math.PI) / 180;
  const size = 11 + i * 0.9; // en % du cercle : de 11 % à 20 %
  const radius = 50 - 20 / 2; // centre des pastilles sur un cercle qui laisse tenir la plus grande
  return {
    photo,
    size: `${size}%`,
    left: `${50 + radius * Math.cos(angle) - size / 2}%`,
    top: `${50 + radius * Math.sin(angle) - size / 2}%`,
  };
});

const quiSommesNous =
  "Cayrol Energie est une société du groupe familial Cayrol, producteur indépendant d'énergie renouvelable depuis 50 ans. " +
  "Elle répond à une volonté locale d'indépendance énergétique des territoires et accompagne entreprises et " +
  "collectivités dans la maîtrise de leur énergie.";

// Frise des 3 générations. TODO-CONTENT : dates et jalons absents du site actuel — structure
// posée (origines hydro → développement → 4 filières aujourd'hui), textes à valider/compléter.
const generations = [
  {
    tag: "1ʳᵉ génération",
    date: null,
    title: "Les origines, au fil de l'eau",
    body: "Les premières centrales hydroélectriques de la famille Cayrol, en Savoie.",
    color: hydro.color,
  },
  {
    tag: "2ᵉ génération",
    date: null,
    title: "Le développement",
    body: "Jalons à préciser : nouvelles centrales, arrivée du photovoltaïque, installation dans l'Hérault…",
    color: theme.color,
  },
  {
    tag: "3ᵉ génération",
    date: "Aujourd'hui",
    title: "Quatre filières, un même ancrage",
    body: "Hydroélectricité, photovoltaïque, stockage par batteries et biogaz : développés, construits et exploités par Cayrol Energie.",
    color: pv.color,
  },
];

// Deux territoires : projets réels de projects.json répartis par latitude — le quart Alpes
// (Savoie et alentours) au nord de 44,8°, le pourtour méditerranéen (Hérault et alentours) au
// sud. Le site actuel parle d'ancrage "Dpts 73 & 34" ; les projets hors de ces 2 départements
// sont rattachés au territoire le plus proche plutôt que masqués.
const uniqueProjects = Array.from(new Map(projects.map((p) => [p.id, p])).values());
const alpes = uniqueProjects.filter((p) => p.lat >= 44.8);
const sud = uniqueProjects.filter((p) => p.lat < 44.8);
const territoires = [
  {
    name: "Savoie",
    title: "Au pied des Alpes",
    body: "Le berceau familial, où l'eau des montagnes fait tourner nos premières centrales.",
    photo: photoUrl("hydroHauteChute", { w: 1400 }),
    color: hydro.color,
    projects: alpes,
  },
  {
    name: "Hérault",
    title: "Sous le soleil du Sud",
    body: "Toitures, ombrières et centrales au sol au plus près des acteurs économiques du territoire.",
    photo: photoUrl("pvAuSol", { w: 1400 }),
    color: pv.color,
    projects: sud,
  },
];

// 5 valeurs du site actuel, textes repris tels quels.
const valeurs = [
  { title: "Accompagnement sur mesure", body: "Les projets sont étudiés au cas par cas par une équipe d'ingénieurs qualifiés et expérimentés." },
  { title: "Professionnalisme", body: "Nos équipes s'investissent avec implication et réactivité pour apporter les réponses les mieux adaptées aux besoins de chacun de nos clients." },
  { title: "Suivi rigoureux", body: "Vous disposez d'un contact unique de A à Z, avec des points d'avancement réguliers." },
  { title: "Transparence", body: "Les décisions sont prises en concertation avec le propriétaire, en toute transparence." },
  { title: "Expertise", body: "Les projets font l'objet d'études techniques approfondies, validées par nos experts." },
];
// Valeurs posées sur le cercle du sigle : angle de départ en haut (-90°), réparties à 72°.
const valeurPositions = valeurs.map((_, i) => {
  const angle = ((-90 + i * 72) * Math.PI) / 180;
  return { left: `${50 + 50 * Math.cos(angle)}%`, top: `${50 + 50 * Math.sin(angle)}%` };
});

// 6 points forts du site actuel.
const pointsForts = [
  "Plus de 50 années d'expertise en EnR",
  "Une entreprise familiale depuis 3 générations",
  "Des offres personnalisées et sur mesure",
  "Un interlocuteur unique tout au long du projet",
  "Un partenariat basé sur la longévité et la proximité",
  "Un véritable ancrage territorial en Savoie (73) et dans l'Hérault (34)",
];

// Labels : mêmes logos que le bandeau partenaires du footer (src/data/company.ts), pas de copie.
const labels = partners.filter((p) => p.logo && ["QualiPV", "La French Tech Green 20", "Le French Lab"].includes(p.name));
---

<BaseLayout title="Société" theme="societe">
  <!-- 1. Hero : manifeste typographique à gauche (se colore mot par mot au chargement), sigle
       Cayrol recomposé en photos à droite — les 11 points du cercle deviennent 11 pastilles photo
       des filières, de taille croissante comme dans le logo, qui tournent lentement autour de
       "50 ans". Volontairement différent du hero plein écran de l'accueil (retour client). -->
  <section class="relative overflow-hidden bg-orange-50/60">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 md:grid-cols-[1.1fr_1fr] md:py-24">
      <div>
        <p class="mb-5 text-sm font-semibold tracking-[0.2em] uppercase" style={`color:${theme.color}`}>Notre société</p>
        <p id="manifeste-text" class="text-3xl leading-tight font-extrabold md:text-[2.6rem]">
          {manifeste.split(" ").map((word, i) => (
            <span
              class="manifeste-word mr-[0.3em] inline-block"
              style={`transition-delay:${i * 70}ms`}
              data-key={/locale|décentralisée|consommation/.test(word) ? "" : undefined}
            >{word}</span>
          ))}
        </p>
      </div>

      <div class="relative mx-auto aspect-square w-full max-w-[26rem]" aria-hidden="true">
        <div class="sigle-ring absolute inset-0">
          {sigleDots.map((d) => (
            <div
              class="sigle-dot absolute overflow-hidden rounded-full border-4 border-white shadow-lg"
              style={`left:${d.left}; top:${d.top}; width:${d.size}; height:${d.size};`}
            >
              <img src={d.photo} alt="" class="h-full w-full object-cover" loading="eager" />
            </div>
          ))}
        </div>
        <div class="absolute inset-0 flex flex-col items-center justify-center text-center">
          <p class="text-6xl leading-none font-extrabold md:text-7xl" style={`color:${theme.color}`}>50</p>
          <p class="mt-1 text-sm font-semibold tracking-[0.15em] text-slate-600 uppercase">ans d'énergie<br />renouvelable</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Qui sommes-nous : court paragraphe de transition entre le manifeste et la frise. -->
  <section class="bg-white">
    <div class="mx-auto max-w-3xl px-4 py-20 text-center md:py-28">
      <h1 class="mb-5 text-3xl font-extrabold text-slate-900 md:text-4xl">Des territoires et des Hommes</h1>
      <p class="text-lg leading-relaxed text-neutral-700">{quiSommesNous}</p>
    </div>
  </section>

  <!-- 2. Frise des 3 générations : trait vertical révélé au scroll (clip-path piloté par la
       progression, pas scaleY qui compressait le dégradé), chaque étape s'allume quand le trait
       l'atteint. Dégradé calé sur les pastilles en JS : chaque portion du trait a la couleur de
       l'étape qu'elle rejoint. -->
  <section id="frise" class="border-t border-slate-200/80 bg-orange-50/60">
    <div class="mx-auto max-w-4xl px-4 py-20 md:py-28">
      <p class="mb-2 text-center text-sm font-semibold tracking-[0.2em] uppercase" style={`color:${theme.color}`}>50 ans, 3 générations</p>
      <h2 class="mb-16 text-center text-3xl font-bold text-slate-900 md:text-4xl">Une histoire de famille</h2>
      <ol class="relative">
        <span class="absolute top-0 bottom-0 left-5 w-0.5 bg-slate-200 md:left-1/2 md:-translate-x-1/2" aria-hidden="true"></span>
        <span
          id="frise-line"
          class="absolute top-0 bottom-0 left-5 w-0.5 md:left-1/2 md:-translate-x-1/2"
          style={`background:linear-gradient(to bottom, ${hydro.color}, ${theme.color}, ${pv.color}); clip-path:inset(0 0 100% 0);`}
          aria-hidden="true"
        ></span>
        {generations.map((g, i) => (
          <li class:list={["frise-step relative mb-16 pl-16 last:mb-0 md:w-1/2 md:pl-0", i % 2 === 0 ? "md:pr-14 md:text-right" : "md:ml-auto md:pl-14"]}>
            <span
              class:list={["frise-dot absolute top-1 left-5 h-5 w-5 -translate-x-1/2 rounded-full border-4 border-white bg-slate-300 shadow transition-colors duration-500", i % 2 === 0 ? "md:left-auto md:right-0 md:translate-x-1/2" : "md:left-0"]}
              data-color={g.color}
              aria-hidden="true"
            ></span>
            <p class="text-xs font-bold tracking-[0.15em] uppercase" style={`color:${g.color}`}>{g.tag}</p>
            <p class="mt-1 text-2xl font-extrabold text-slate-900">
              {g.date ?? <span class="todo-badge">Date à compléter</span>}
            </p>
            <h3 class="mt-2 text-lg font-bold text-slate-800">{g.title}</h3>
            <p class="mt-1 text-neutral-600">{g.body}</p>
            {i < 2 && <p class="mt-2"><span class="todo-badge">Jalons à compléter</span></p>}

            {/* Illustration animée de l'étape, de l'autre côté du trait sur desktop (sous le
                texte sur mobile) ; démarre quand le trait atteint l'étape (.is-reached). */}
            <div
              class:list={["frise-illu mt-5 h-36 w-64 md:absolute md:-top-4 md:mt-0 md:h-40", i % 2 === 0 ? "md:left-[calc(100%+3.5rem)]" : "md:right-[calc(100%+3.5rem)]"]}
              aria-hidden="true"
            >
              {i === 0 && (
                // 1. Au fil de l'eau : roue à aubes qui tourne dans deux vagues qui s'écoulent.
                // Vagues masquées (fondu sur les bords) : le chemin fait 480px de large pour
                // boucler, sans masque il débordait sur le texte.
                <svg viewBox="0 0 240 150" class="h-full w-full">
                  <defs>
                    <linearGradient id="illu-fade" x1="0" x2="1" y1="0" y2="0">
                      <stop offset="0" stop-color="#fff" stop-opacity="0" />
                      <stop offset="0.15" stop-color="#fff" stop-opacity="1" />
                      <stop offset="0.85" stop-color="#fff" stop-opacity="1" />
                      <stop offset="1" stop-color="#fff" stop-opacity="0" />
                    </linearGradient>
                    <mask id="illu-water-mask">
                      <rect x="0" y="0" width="240" height="150" fill="url(#illu-fade)" />
                    </mask>
                  </defs>
                  <g class="illu-wheel" style="transform-origin: 120px 70px">
                    <circle cx="120" cy="70" r="38" fill="none" stroke={hydro.color} stroke-width="4" />
                    <circle cx="120" cy="70" r="7" fill={hydro.color} />
                    {Array.from({ length: 8 }, (_, k) => (
                      <g transform={`rotate(${k * 45} 120 70)`}>
                        <line x1="120" y1="70" x2="120" y2="30" stroke={hydro.color} stroke-width="3" />
                        <rect x="112" y="22" width="16" height="12" rx="2" fill={hydro.colorLight} stroke={hydro.color} stroke-width="2" />
                      </g>
                    ))}
                  </g>
                  <g mask="url(#illu-water-mask)">
                    <g class="illu-wave illu-wave--back">
                      <path d="M0 102 Q30 90 60 102 T120 102 T180 102 T240 102 T300 102 T360 102 T420 102 T480 102 V150 H0 Z" fill={hydro.colorLight} opacity="0.7" />
                    </g>
                    <g class="illu-wave illu-wave--front">
                      <path d="M0 112 Q30 100 60 112 T120 112 T180 112 T240 112 T300 112 T360 112 T420 112 T480 112 V150 H0 Z" fill={hydro.color} opacity="0.85" />
                    </g>
                  </g>
                </svg>
              )}
              {i === 1 && (
                // 2. Le développement : soleil qui se lève, panneaux posés un par un.
                <svg viewBox="0 0 240 150" class="h-full w-full overflow-visible">
                  <g class="illu-sun">
                    <circle cx="190" cy="40" r="18" fill="#fbbf24" />
                    <circle class="illu-sun-halo" cx="190" cy="40" r="26" fill="#fbbf24" opacity="0.25" />
                  </g>
                  <line x1="0" y1="130" x2="240" y2="130" stroke="#cbd5e1" stroke-width="3" stroke-linecap="round" />
                  {Array.from({ length: 5 }, (_, k) => (
                    <g class="illu-panel" style={`--d:${300 + k * 220}ms; transform-origin:${22 + k * 44}px 130px`}>
                      <line x1={22 + k * 44} y1="130" x2={22 + k * 44} y2="108" stroke="#64748b" stroke-width="3" />
                      <path d={`M${4 + k * 44} 110 L${16 + k * 44} 84 L${46 + k * 44} 84 L${34 + k * 44} 110 Z`} fill={theme.colorDark} stroke={pv.color} stroke-width="2" />
                      <line x1={10 + k * 44} y1="97" x2={40 + k * 44} y2="97" stroke={pv.colorLight} stroke-width="1" opacity="0.7" />
                    </g>
                  ))}
                </svg>
              )}
              {i === 2 && (
                // 3. Quatre filières, un même ancrage : les 4 sigles colorés convergent autour
                // d'un repère de carte (l'ancrage territorial).
                // Carré centré (largeur = hauteur) : sigles symétriques dans ses 4 coins et
                // repère centré par flex, donc pile au milieu des 4 filières.
                <div class="relative mx-auto aspect-square h-full">
                  {[
                    { src: "/logos/sigle-bleu.png", x: "-40%", y: "-30%", pos: "left:4%; top:4%" },
                    { src: "/logos/sigle-orange.png", x: "40%", y: "-30%", pos: "right:4%; top:4%" },
                    { src: "/logos/sigle-rouge.png", x: "-40%", y: "30%", pos: "left:4%; bottom:4%" },
                    { src: "/logos/sigle-vert.png", x: "40%", y: "30%", pos: "right:4%; bottom:4%" },
                  ].map((s, k) => (
                    <img
                      src={s.src}
                      alt=""
                      class="illu-sigle absolute h-[42%] w-[42%]"
                      style={`${s.pos}; --x:${s.x}; --y:${s.y}; --d:${k * 150}ms`}
                    />
                  ))}
                  <div class="absolute inset-0 flex items-center justify-center">
                    {/* Ombre au sol sous la pointe du repère (retour client : notion
                        d'implantation) ; reste au sol pendant que le repère tombe. */}
                    <div class="relative h-[30%]">
                      <span class="illu-pin-shadow absolute bottom-[-7%] left-1/2 h-[16%] w-[80%] rounded-[50%] bg-slate-900/35 blur-[1.5px]"></span>
                      <svg viewBox="0 0 24 32" class="illu-pin relative h-full w-auto">
                        <path d="M12 0C5.4 0 0 5.2 0 11.7 0 20.5 12 32 12 32s12-11.5 12-20.3C24 5.2 18.6 0 12 0Z" fill="#0f172a" />
                        <circle cx="12" cy="11.5" r="4.5" fill="#fff" />
                      </svg>
                    </div>
                  </div>
                </div>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 3. Deux territoires : écran partagé Savoie (hydro, bleu) / Hérault (PV, orange), chaque
       moitié liste les projets réels de sa zone. Au survol, la moitié survolée s'élargit. -->
  <section class="territoires flex min-h-[80vh] flex-col md:flex-row" aria-label="Nos deux territoires">
    {territoires.map((t) => (
      <article class="territoire group relative flex flex-1 flex-col justify-end overflow-hidden px-6 py-16 text-white md:px-12 md:py-20">
        <img src={t.photo} alt="" loading="lazy" class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" />
        <div class="absolute inset-0" style={`background:linear-gradient(to top, color-mix(in oklch, ${t.color}, black 35%) 10%, color-mix(in oklch, ${t.color}, transparent 45%) 60%, transparent)`} aria-hidden="true"></div>
        <div class="relative">
          {/* Nom du département seul : le grand numéro (73 / 34) se lisait comme un chiffre clé
              (retour client). */}
          <p class="text-base font-bold tracking-[0.25em] uppercase md:text-lg">{t.name}</p>
          <h2 class="mt-4 text-3xl font-bold md:text-4xl">{t.title}</h2>
          <p class="mt-2 max-w-md text-white/85">{t.body}</p>
          <p class="mt-6 text-sm font-semibold">{t.projects.length} projets dans la zone</p>
          <ul class="mt-2 flex max-w-lg flex-wrap gap-2">
            {/* Une pastille par commune (Argentine compte 2 projets). */}
            {[...new Set(t.projects.map((p) => p.commune))].map((commune) => (
              <li class="rounded-full bg-white/15 px-3 py-1 text-xs font-medium backdrop-blur-sm">{commune}</li>
            ))}
          </ul>
        </div>
      </article>
    ))}
  </section>

  <!-- 4. Valeurs autour du sigle : le cercle de points du logo Cayrol au centre, les 5 valeurs
       posées sur son pourtour ; survol/clic/focus d'une valeur l'affiche au centre. Sur mobile,
       simple liste (le cercle n'a pas la place). -->
  <section class="bg-white">
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-28">
      <h2 class="mb-3 text-center text-3xl font-bold text-slate-900 md:text-4xl">Nos valeurs</h2>
      <p class="mb-16 text-center text-lg text-neutral-600">Ce qui guide chacun de nos projets.</p>

      <div id="valeurs-ring" class="relative mx-auto hidden aspect-square w-[min(34rem,100%)] md:block">
        <img src={theme.logo} alt="" class="valeurs-sigle absolute inset-[18%] h-[64%] w-[64%] opacity-15" aria-hidden="true" />
        <div class="absolute inset-[26%] flex flex-col items-center justify-center text-center">
          {valeurs.map((v, i) => (
            <div class="valeur-panel absolute inset-0 flex flex-col items-center justify-center transition-opacity duration-300" data-index={i} style={i === 0 ? "" : "opacity:0"}>
              <p class="text-xl font-extrabold" style={`color:${theme.color}`}>{v.title}</p>
              <p class="mt-2 text-sm leading-relaxed text-neutral-700">{v.body}</p>
            </div>
          ))}
        </div>
        {valeurs.map((v, i) => (
          <button
            type="button"
            class="valeur-btn absolute -translate-x-1/2 -translate-y-1/2 rounded-full border-2 bg-white px-4 py-2 text-sm font-bold whitespace-nowrap shadow-md transition-colors"
            style={`left:${valeurPositions[i].left}; top:${valeurPositions[i].top}; border-color:${theme.color}; color:${theme.color}`}
            data-index={i}
            aria-pressed={i === 0 ? "true" : "false"}
          >
            {v.title}
          </button>
        ))}
      </div>

      <ul class="grid gap-4 md:hidden">
        {valeurs.map((v) => (
          <li class="rounded-2xl border border-orange-200 bg-orange-50/60 p-5">
            <p class="font-bold" style={`color:${theme.color}`}>{v.title}</p>
            <p class="mt-1 text-sm text-neutral-700">{v.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 5. Bandeau de confiance (labels + 6 points forts). Pas d'appel au contact dédié ici : le
       footer global en porte déjà un juste en dessous. -->
  <section class="bg-slate-900 text-white">
    <div class="mx-auto max-w-6xl px-4 py-16 md:py-20">
      <h2 class="mb-10 text-2xl font-bold md:text-3xl">Le partenaire de votre transition énergétique</h2>
      <ul class="grid gap-x-10 gap-y-5 sm:grid-cols-2 lg:grid-cols-3">
        {pointsForts.map((p) => (
          <li class="flex items-start gap-3">
            <span class="mt-2 h-2 w-2 shrink-0 rounded-full" style={`background-color:${theme.color}`}></span>
            <span class="text-white/85">{p}</span>
          </li>
        ))}
      </ul>
      <div class="mt-12 flex flex-wrap items-center gap-4 border-t border-white/10 pt-10">
        <span class="mr-2 text-sm font-semibold text-white/60">Labels et réseaux :</span>
        {labels.map((l) => (
          <span class="flex h-20 items-center justify-center rounded-xl bg-white px-5 py-3">
            <img src={l.logo} alt={l.name} class:list={["w-auto object-contain", l.compact ? "h-full" : "h-10"]} />
          </span>
        ))}
      </div>
    </div>
  </section>

  <style>
    /* Manifeste : gris clair → ardoise (mots-clés → orange), en cascade grâce au
       transition-delay posé mot par mot dans le HTML. */
    .manifeste-word {
      color: #e2cfc2;
      transition: color 0.5s ease;
    }
    .manifeste-word.is-lit {
      color: #0f172a;
    }
    .manifeste-word.is-lit[data-key] {
      color: #ea580c;
    }
    /* Sigle en photos : le cercle tourne, chaque photo tourne en sens inverse pour rester droite. */
    .sigle-ring {
      animation: sigle-spin 80s linear infinite;
    }
    .sigle-dot img {
      animation: sigle-spin 80s linear infinite reverse;
    }
    @keyframes sigle-spin {
      to {
        transform: rotate(360deg);
      }
    }
    .todo-badge {
      display: inline-block;
      border: 1px dashed #f97316;
      border-radius: 9999px;
      padding: 0.1rem 0.6rem;
      font-size: 0.75rem;
      font-weight: 600;
      color: #c2410c;
      background: #fff7ed;
      vertical-align: middle;
    }
    /* Deux territoires : la moitié survolée s'élargit (desktop uniquement). */
    @media (min-width: 768px) {
      .territoire {
        transition: flex-grow 0.6s ease;
      }
      .territoires:hover .territoire:hover {
        flex-grow: 1.5;
      }
    }
    .valeurs-sigle {
      animation: valeurs-spin 60s linear infinite;
    }
    @keyframes valeurs-spin {
      to {
        transform: rotate(360deg);
      }
    }
    /* Illustrations de la frise : état de départ discret, animations lancées quand le trait
       atteint l'étape (.is-reached posé par le script). */
    .frise-illu {
      opacity: 0.35;
      transition: opacity 0.8s ease;
    }
    .frise-step.is-reached .frise-illu {
      opacity: 1;
    }
    /* 1. Vagues : chemin de 480px de large translaté d'une période (240px) en boucle. */
    .illu-wave {
      animation: illu-flow 4s linear infinite;
      animation-play-state: paused;
    }
    .illu-wave--back {
      animation-duration: 6s;
      animation-direction: reverse;
    }
    .illu-wheel {
      animation: illu-turn 6s linear infinite;
      animation-play-state: paused;
    }
    .frise-step.is-reached :is(.illu-wave, .illu-wheel) {
      animation-play-state: running;
    }
    @keyframes illu-flow {
      to {
        transform: translateX(-240px);
      }
    }
    @keyframes illu-turn {
      to {
        transform: rotate(360deg);
      }
    }
    /* 2. Soleil qui se lève puis halo qui respire ; panneaux posés un par un (--d). */
    .illu-sun {
      transform: translateY(70px);
      opacity: 0;
      transition: transform 1.4s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 1s ease;
    }
    .frise-step.is-reached .illu-sun {
      transform: none;
      opacity: 1;
    }
    .illu-sun-halo {
      transform-box: fill-box;
      transform-origin: center;
      animation: illu-breathe 3s ease-in-out infinite;
    }
    @keyframes illu-breathe {
      50% {
        transform: scale(1.25);
        opacity: 0.1;
      }
    }
    .illu-panel {
      transform: scaleY(0);
      opacity: 0;
      transition: transform 0.6s cubic-bezier(0.3, 1.4, 0.5, 1) var(--d), opacity 0.3s ease var(--d);
    }
    .frise-step.is-reached .illu-panel {
      transform: none;
      opacity: 1;
    }
    /* 3. Les 4 sigles partent de l'extérieur (--x/--y) et se rejoignent, puis tournent sur place ;
       le repère tombe au centre une fois les sigles réunis. */
    .illu-sigle {
      transform: translate(var(--x), var(--y)) scale(0.6);
      opacity: 0;
      transition: transform 1s cubic-bezier(0.2, 0.8, 0.2, 1) var(--d), opacity 0.6s ease var(--d);
    }
    .frise-step.is-reached .illu-sigle {
      transform: none;
      opacity: 1;
      animation: illu-turn 20s linear 1.6s infinite;
    }
    .illu-pin {
      transform: translateY(-60px);
      opacity: 0;
      transition: transform 0.7s cubic-bezier(0.3, 1.5, 0.5, 1) 1s, opacity 0.3s ease 1s;
    }
    .frise-step.is-reached .illu-pin {
      transform: none;
      opacity: 1;
    }
    /* Ombre : petite et pâle tant que le repère est en l'air, grandit en même temps que sa chute. */
    .illu-pin-shadow {
      transform: translateX(-50%) scale(0.3);
      opacity: 0;
      transition: transform 0.7s cubic-bezier(0.3, 1.5, 0.5, 1) 1s, opacity 0.5s ease 1s;
    }
    .frise-step.is-reached .illu-pin-shadow {
      transform: translateX(-50%) scale(1);
      opacity: 1;
    }

    @media (prefers-reduced-motion: reduce) {
      .valeurs-sigle,
      .sigle-ring,
      .sigle-dot img,
      .illu-wave,
      .illu-wheel,
      .illu-sun-halo,
      .frise-step.is-reached .illu-sigle {
        animation: none;
      }
    }
  </style>

  <script>
    // Manifeste (au chargement) + frise (au scroll). Rebranché à chaque navigation
    // (astro:page-load) pour les transitions de page, comme sur l'accueil.
    function initSociete() {
      const words = Array.from(document.querySelectorAll<HTMLElement>(".manifeste-word"));
      const line = document.getElementById("frise-line");
      const dots = Array.from(document.querySelectorAll<HTMLElement>(".frise-dot"));
      if (!line) return;

      // Manifeste : la cascade de couleur démarre juste après l'affichage (délais par mot en CSS).
      requestAnimationFrame(() => words.forEach((w) => w.classList.add("is-lit")));

      const update = () => {
        // Frise : la pointe du trait suit un repère à 60 % de la hauteur d'écran, dans les deux
        // sens ; pastille et illustration s'allument quand la pointe atteint le centre de la
        // pastille, et s'éteignent quand on remonte au-dessus.
        const tip = window.innerHeight * 0.6;
        const rect = line.getBoundingClientRect();
        const progress = Math.min(Math.max((tip - rect.top) / rect.height, 0), 1);
        line.style.clipPath = `inset(0 0 ${((1 - progress) * 100).toFixed(2)}% 0)`;
        const stops: string[] = [];
        dots.forEach((dot) => {
          const r = dot.getBoundingClientRect();
          const center = r.top + r.height / 2;
          stops.push(`${dot.dataset.color} ${(((center - rect.top) / rect.height) * 100).toFixed(1)}%`);
          const reached = center <= tip;
          dot.style.backgroundColor = reached ? (dot.dataset.color ?? "") : "";
          dot.closest(".frise-step")?.classList.toggle("is-reached", reached);
        });
        line.style.background = `linear-gradient(to bottom, ${stops.join(", ")})`;
      };
      update();
      window.addEventListener("scroll", update, { passive: true });
      window.addEventListener("resize", update);
      document.addEventListener("astro:before-swap", () => {
        window.removeEventListener("scroll", update);
        window.removeEventListener("resize", update);
      }, { once: true });

      // Valeurs : survol / clic / focus d'une valeur l'affiche au centre du cercle.
      const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>(".valeur-btn"));
      const panels = Array.from(document.querySelectorAll<HTMLElement>(".valeur-panel"));
      const select = (index: string | undefined) => {
        buttons.forEach((b) => {
          const on = b.dataset.index === index;
          b.setAttribute("aria-pressed", String(on));
          b.style.backgroundColor = on ? "#ea580c" : "#fff";
          b.style.color = on ? "#fff" : "#ea580c";
        });
        panels.forEach((panel) => (panel.style.opacity = panel.dataset.index === index ? "1" : "0"));
      };
      buttons.forEach((b) => {
        ["mouseenter", "focus", "click"].forEach((evt) => b.addEventListener(evt, () => select(b.dataset.index)));
      });
      select("0");
    }
    document.addEventListener("astro:page-load", initSociete);
  </script>
</BaseLayout>
