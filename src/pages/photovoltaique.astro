---
import BaseLayout from "../layouts/BaseLayout.astro";
import AnimatedHero from "../components/AnimatedHero.astro";
import OrganicImageHero from "../components/OrganicImageHero.astro";
import ThematicTab from "../components/ThematicTab.tsx";
import ScrollStepGallery from "../components/ScrollStepGallery.tsx";
import ProjectScrollShowcase from "../components/ProjectScrollShowcase.astro";
import { themes } from "../data/themes";
import { photoUrl, photos } from "../data/photos";
import projects from "../data/projects.json";

const theme = themes.photovoltaique;

// Contenu repris de la maquette client retour_site_internet/cayrol-photovoltaique.html (textes issus
// de cayrolenergie.com) : accroche, chiffres clés, paragraphe métier, descriptions des 4 types,
// déroulé d'un projet type. Le contact est porté par le bandeau du footer (commun à tout le site).
const keyFigures = [
  { value: 64, suffix: "", label: "centrales photovoltaïques en exploitation" },
  { value: 50, suffix: "+", label: "années d'expertise en énergies renouvelables" },
  { value: 3, suffix: "", label: "générations à la tête d'une entreprise familiale" },
  { value: 2, suffix: "", label: "départements d'ancrage territorial — 73 & 34" },
];

// 4 projets phares, un par mode de pose (retour client), présentés comme sur la page Hydro.
// Star Soleil a de vraies photos ; Aiton reprend la photo toiture.
// TODO-CONTENT : aucun projet "Au sol" ni "Agrivoltaïsme" dans les données fournies — emplacements
// à compléter par le client (nom, commune, puissance, description, photo).
const project = (id: string) => projects.find((p) => p.id === id)!;
const starSoleil = project("star-soleil");
const aiton = project("aiton");
const featuredProjects = [
  {
    name: aiton.name,
    type: aiton.type,
    commune: aiton.commune,
    power: aiton.power,
    description: aiton.description,
    image: photoUrl("pvToiture", { w: 900 }),
  },
  {
    name: starSoleil.name,
    type: starSoleil.type,
    commune: starSoleil.commune,
    power: starSoleil.power,
    description: starSoleil.description,
    image: "/projets/star-soleil/principale.jpg",
    href: "/projets/star-soleil",
  },
  {
    name: "Centrale au sol",
    type: "Au sol",
    commune: "TODO-CONTENT",
    power: "—",
    description: "TODO-CONTENT : projet de centrale au sol phare à fournir par le client (nom, commune, puissance, courte description, photo).",
    image: `${photos.pvAuSol}?w=900&h=675&q=80&auto=format&fit=crop`,
  },
  {
    name: "Projet agrivoltaïque",
    type: "Agrivoltaïsme",
    commune: "TODO-CONTENT",
    power: "—",
    description: "TODO-CONTENT : projet agrivoltaïque phare à fournir par le client (nom, commune, puissance, courte description, photo).",
    image: `${photos.pvAgrivoltaisme}?w=900&h=675&q=80&auto=format&fit=crop`,
  },
];

// Déroulé d'un projet type : une phrase simple et une photo par étape, sans durée (retour client).
const timelineSteps = [
  { label: "Étude de faisabilité", description: "Analyse technique et administrative du site." },
  { label: "Dépôt du permis de construire", description: "Constitution et dépôt du dossier." },
  { label: "Instruction & raccordement", description: "Instruction du permis, demande de raccordement au réseau." },
  { label: "Construction", description: "Installation des panneaux et du poste de livraison." },
  { label: "Mise en service", description: "Raccordement au réseau et démarrage de la production." },
];

// TODO-CONTENT : réemploi des 4 photos de catégories + la photo hero faute de photos dédiées à
// chaque étape du chantier dans les données actuelles ; à remplacer par de vraies photos de
// chantier (étude terrain, dépôt de dossier, tranchée de raccordement, pose des panneaux, mise en
// service) si le client peut en fournir.
const scrollGallerySteps = [
  { ...timelineSteps[0], image: photoUrl("pvAuSol", { w: 1400 }) },
  { ...timelineSteps[1], image: photoUrl("heroAccueil", { w: 1400 }) },
  { ...timelineSteps[2], image: photoUrl("pvOmbrieres", { w: 1400 }) },
  { ...timelineSteps[3], image: photoUrl("pvToiture", { w: 1400 }) },
  { ...timelineSteps[4], image: photoUrl("pvAgrivoltaisme", { w: 1400 }) },
];
---

<BaseLayout title="Photovoltaïque" theme="photovoltaique" hideServiceRail>
  <!-- Même hero que Hydro / Biogaz / BESS (retour : harmoniser les pages métiers) : titre coloré
       au scroll, photo découpée avec le logo dans l'encoche (bas-droite pour le photovoltaïque),
       chiffres clés animés à l'arrivée sur la page. -->
  <AnimatedHero
    heroId="pv-hero"
    eyebrow={theme.name}
    title="Valoriser chaque toiture, chaque parking, chaque terrain inexploité."
    color={theme.color}
  >
    <Fragment slot="lead">
      <p class="mt-4 text-sm leading-relaxed text-slate-600 md:text-base">
        En source d'énergie renouvelable, à taille humaine : 64 centrales photovoltaïques conçues sur-mesure depuis
        nos premières installations.
      </p>

      <div class="mt-8 grid grid-cols-2 gap-x-6 gap-y-5">
        {keyFigures.map((f) => (
          <div>
            <p class="text-3xl font-extrabold" style={`color:${theme.color}`} data-countup={f.value} data-suffix={f.suffix}>
              {f.value}{f.suffix}
            </p>
            <p class="text-sm text-slate-500">{f.label}</p>
          </div>
        ))}
      </div>
    </Fragment>

    <OrganicImageHero
      slot="image"
      src={photoUrl("pvAuSol", { w: 1800 })}
      alt="Centrale photovoltaïque au sol"
      logo={theme.logo}
      variant="tab"
      class="h-[340px] w-full sm:h-[420px] md:h-[520px] lg:h-[min(680px,calc(100vh-var(--header-h,61px)-4rem))]"
    />
  </AnimatedHero>

  <section id="realisations">
  <div class="mx-auto max-w-7xl px-4 py-14">
    <ThematicTab
      client:visible
      color={theme.color}
      explanations={[
        {
          title: "Un savoir-faire photovoltaïque intégré",
          body: "Cayrol Energie conçoit, construit et exploite des installations photovoltaïques adaptées à chaque foncier — toiture ou hangar agricole, ombrière de parking, centrale au sol ou projet agrivoltaïque. Nous intervenons depuis la prospection et la conception jusqu'à la mise en production, en travaillant avec plusieurs fournisseurs pour retenir la meilleure technologie selon chaque projet. Chaque installation est pensée en intégrant les enjeux locaux dès l'origine, pour s'inscrire durablement dans son environnement et générer une synergie avec l'activité du site. Une équipe dédiée assure ensuite un suivi quotidien de la production et des visites régulières, pour une exploitation fiable sur le long terme — l'esprit d'une entreprise familiale, à taille humaine, depuis trois générations.",
        },
      ]}
      categories={[
        {
          label: "Toiture",
          image: photoUrl("pvToiture", { w: 1400 }),
          description: "Toitures et hangars agricoles ou industriels équipés sans emprise au sol supplémentaire.",
          href: "/photovoltaique/toiture",
          transitionName: "pv-type-toiture",
        },
        {
          label: "Ombrières",
          image: photoUrl("pvOmbrieres", { w: 1400 }),
          description: "Couvrez vos parkings et protégez vos visiteurs tout en produisant de l'énergie.",
          href: "/photovoltaique/ombrieres",
          transitionName: "pv-type-ombrieres",
        },
        {
          label: "Au sol",
          image: photoUrl("pvAuSol", { w: 1400 }),
          description: "Terrains dégradés, friches ou carrières valorisés en source d'énergie renouvelable.",
          href: "/photovoltaique/sol",
          transitionName: "pv-type-sol",
        },
        {
          label: "Agrivoltaïsme",
          image: photoUrl("pvAgrivoltaisme", { w: 1400 }),
          description: "Serres et persiennes photovoltaïques pour protéger les cultures et produire de l'énergie.",
          href: "/photovoltaique/agrivoltaisme",
          transitionName: "pv-type-agrivoltaisme",
        },
      ]}
      categoriesIntro="Quatre façons de valoriser un foncier en source d'énergie renouvelable — chacune fait l'objet d'une page dédiée."
    />

  </div>
  </section>

  <!-- Déroulé d'un projet type au scroll (façon business.nrg.com) : une photo et une phrase par
       étape, sans durée. Hangar photovoltaïque : page dédiée (/photovoltaique/hangar) sans carte
       dans la grille ci-dessus, en attente de décision client sur une 5ᵉ catégorie. -->
  <section class="border-t border-slate-200/80 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-14">
      <h2 class="mb-2 text-2xl font-bold text-neutral-900">Déroulement d'un projet type</h2>
      <p class="mb-10 text-neutral-600">De l'étude de faisabilité à la mise en service, cinq grandes étapes structurent chaque projet.</p>
      <ScrollStepGallery client:visible steps={scrollGallerySteps} color={theme.color} />
    </div>
  </section>


  <ProjectScrollShowcase title="Présentation de projets" color={theme.color} projects={featuredProjects} />
</BaseLayout>
