---
import BaseLayout from "../layouts/BaseLayout.astro";
import AnimatedHero from "../components/AnimatedHero.astro";
import OrganicImageHero from "../components/OrganicImageHero.astro";
import BessScrollytelling from "../components/BessScrollytelling.tsx";
import StackedCards from "../components/StackedCards.astro";
import PriseEnChargePath from "../components/PriseEnChargePath.astro";
import { themes } from "../data/themes";
import { photoUrl } from "../data/photos";

const theme = themes["flexibilite-bess"];

// Contenu transcrit du support de cadrage client (engagements, atouts, description du terrain,
// déroulement). Retour client : même DA que les autres pages métiers + schéma de fonctionnement
// animé au scroll (BessScrollytelling).

const engagements = [
  {
    title: "Ancrage territorial",
    body: "Des projets construits en lien direct avec les collectivités et les acteurs économiques locaux.",
  },
  {
    title: "Respect du patrimoine architectural local",
    body: "Une intégration paysagère pensée avec les riverains et les services de l'urbanisme.",
  },
  {
    title: "Savoir-faire historique",
    body: "Plus de 20 ans d'expérience dans le développement et l'exploitation d'installations énergétiques.",
  },
];

const terrain = [
  { value: "2", label: "conteneurs 20 pieds aménagés en parc batterie" },
  { value: "2", label: "postes de refroidissement" },
  { value: "2", label: "postes de transformation" },
];

const atouts = [
  {
    title: "Optimisation de l'énergie",
    body: "Le BESS permet de stocker la production lors des pics de production et de la restituer lors des pics de consommation.",
  },
  {
    title: "Flexibilité et régulation des réseaux",
    body: "Une installation BESS permet de soutenir le réseau électrique français lors des fortes demandes de consommation et de le délester lors des fortes productions.",
  },
  {
    title: "Contribution à la transition énergétique",
    body: "Consommer une énergie verte toute la journée et toute l'année.",
  },
  {
    title: "Valorisation du foncier",
    body: "Valoriser des parcelles inexploitées grâce à une démarche simplifiée, fondée sur la confiance et la transparence.",
  },
];

// Déroulement d'un projet, sans durées (cohérent avec le retour client sur la frise photovoltaïque).
// TODO-CONTENT : chronologie reconstituée à partir d'un schéma PDF dont les colonnes se
// chevauchaient à l'extraction, à faire valider mot pour mot par le client.
const deroulement = [
  { name: "Identification du projet", items: ["Phase d'étude."] },
  { name: "Compromis & permis de construire", items: ["Signature du compromis, dépôt du permis et demande de raccordement."] },
  { name: "Permis obtenu", items: ["Instruction de la demande de raccordement."] },
  { name: "Raccordement obtenu", items: ["Développement du projet."] },
  { name: "Acte authentique", items: ["Signature chez le notaire, puis construction."] },
];

// TODO-CONTENT : logos partenaires non fournis, affichage temporaire en texte.
const partenaires = [
  "CA des Savoie",
  "Communauté Val Cenis Savoie",
  "Territoire d'énergie Savoie Mont-Blanc",
  "Groupe Lauzière",
  "CODEV Savoie",
  "Savoiexpo",
  "Terre de Maurienne",
  "Porte de Maurienne",
];
---

<BaseLayout title="Flexibilité / BESS" theme="flexibilite-bess">
  <AnimatedHero heroId="bess-hero" eyebrow={theme.name} title="Stocker l'énergie pour mieux la restituer." color={theme.color}>
    <Fragment slot="lead">
      <p class="mt-4 text-sm leading-relaxed text-slate-600 md:text-base">
        Le Battery Energy Storage System (BESS) permet de stocker l'électricité produite par nos centrales
        pour la restituer au moment où le réseau en a le plus besoin, une brique essentielle de la
        transition énergétique.
      </p>
    </Fragment>

    <OrganicImageHero
      slot="image"
      src={photoUrl("bessTerrain", { w: 1800 })}
      alt="Conteneurs industriels, illustration d'un site BESS"
      logo={theme.logo}
      variant="step"
      class="h-[340px] w-full sm:h-[420px] md:h-[520px] lg:h-[min(680px,calc(100vh-var(--header-h,61px)-4rem))]"
    />
  </AnimatedHero>

  <!-- Engagements : grands numéros et texte court, sans cadres. -->
  <section class="bg-white py-16 md:py-24">
    <div class="mx-auto grid max-w-7xl gap-12 px-4 md:grid-cols-3 md:gap-10">
      {engagements.map((e, i) => (
        <div>
          <p class="text-6xl font-extrabold leading-none tracking-tight" style={`color:${theme.color}`}>
            {String(i + 1).padStart(2, "0")}
          </p>
          <h2 class="mt-5 text-2xl font-bold !leading-tight text-slate-900">{e.title}</h2>
          <p class="mt-3 leading-relaxed text-slate-600">{e.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Schéma de fonctionnement animé au scroll. -->
  <section class="border-t border-slate-200/80 bg-white pt-14 md:pt-20">
    <div class="mx-auto max-w-7xl px-4">
      <h2 class="text-3xl font-bold !leading-tight text-slate-900 md:text-4xl">Comment fonctionne un BESS ?</h2>
      <p class="mt-3 max-w-2xl text-slate-600">
        Faites défiler pour suivre l'énergie, de la production à sa restitution sur le réseau.
      </p>
    </div>
    <BessScrollytelling client:visible />
  </section>

  <!-- À quoi ressemblera le terrain ? -->
  <section class="bg-white py-16 md:py-24">
    <div class="mx-auto grid max-w-7xl items-center gap-10 px-4 md:grid-cols-2 md:gap-16">
      <div>
        <h2 class="text-3xl font-bold !leading-tight text-slate-900 md:text-4xl">À quoi ressemblera le terrain ?</h2>
        <dl class="mt-10 flex flex-col divide-y divide-slate-200 border-y border-slate-200">
          {terrain.map((t) => (
            <div class="flex items-baseline gap-6 py-5">
              <dt class="w-14 shrink-0 text-5xl font-extrabold leading-none" style={`color:${theme.color}`}>{t.value}</dt>
              <dd class="text-lg text-slate-700">{t.label}</dd>
            </div>
          ))}
        </dl>
      </div>
      <img
        src={photoUrl("bessTerrain", { w: 1200 })}
        alt="Conteneurs industriels, illustration d'un site BESS"
        loading="lazy"
        class="aspect-[4/3] w-full rounded-3xl rounded-tr-none object-cover"
      />
    </div>
  </section>

  <StackedCards title="Les atouts du stockage" items={atouts} color={theme.color} />

  <PriseEnChargePath title="Déroulement d'un projet" phases={deroulement} color={theme.color} />

  <!-- Ils nous font confiance -->
  <section class="bg-white py-16 md:py-20">
    <div class="mx-auto max-w-7xl px-4">
      <h2 class="text-2xl font-bold text-slate-900 md:text-3xl">Ils nous font confiance</h2>
      <ul class="mt-8 flex flex-wrap gap-x-10 gap-y-4 text-lg font-semibold text-slate-400">
        {partenaires.map((nom) => <li>{nom}</li>)}
      </ul>
    </div>
  </section>
</BaseLayout>
