---
// Bloc "prise en charge / accompagnement" d'un type de pose : la liste des services (une douzaine
// de puces dans le docx client) regroupée en 3 phases — Développement, Construction, Exploitation —
// posées sur une ligne horizontale qui se trace au scroll. Fait passer "on s'occupe de tout, de A
// à Z" d'un coup d'œil plutôt qu'en liste.
// Réutilisable avec des jalons explicites (`phases`, ex. déroulement d'un projet BESS) : autant de
// colonnes que de jalons, chacun apparaissant quand la ligne l'atteint.

import type { SolutionBlock } from "../data/photovoltaiqueSolutions";

interface Phase {
  name: string;
  items: string[];
}

interface Props {
  color: string;
  /** Bloc "prise en charge" d'un type de pose PV : services répartis automatiquement en 3 phases. */
  block?: SolutionBlock;
  /** Jalons explicites (prioritaires sur `block`), avec `title` / `intro`. */
  phases?: Phase[];
  title?: string;
  intro?: string;
}

const { block, color } = Astro.props;
const title = Astro.props.title ?? block?.title ?? "";
const intro = Astro.props.intro ?? block?.intro;

// Classement des services par mots-clés : les intitulés varient légèrement d'un type de pose à
// l'autre (ex. "Le chantier" / "Le suivi de construction"), d'où un tri par motif plutôt qu'une
// liste figée. Tout ce qui ne relève ni du chantier ni de l'exploitation part en Développement.
const EXPLOITATION = /contrôle|gestion|maintenance/i;
const CONSTRUCTION = /chantier|construction|mise en service|raccordement|marchés/i;

function phasesFromServices(items: string[]): Phase[] {
  const grouped: Phase[] = [
    { name: "Développement", items: [] },
    { name: "Construction", items: [] },
    { name: "Exploitation", items: [] },
  ];
  for (const item of items) {
    const target = EXPLOITATION.test(item) ? 2 : CONSTRUCTION.test(item) ? 1 : 0;
    grouped[target].items.push(item);
  }
  return grouped;
}

const phases = Astro.props.phases ?? phasesFromServices(block?.items ?? []);
---

<section class="bg-stone-900 py-20 text-white md:py-28" data-path>
  <div class="mx-auto max-w-7xl px-4">
    <div class="grid gap-6 md:grid-cols-12 md:items-end">
      <h2 class="text-3xl font-bold !leading-tight md:col-span-6 md:text-5xl">{title}</h2>
      {intro && <p class="leading-relaxed text-white/70 md:col-span-6">{intro}</p>}
    </div>

    <div class="relative mt-16 md:mt-20">
      <!-- Ligne qui se trace au scroll, passant par les 3 jalons. -->
      <span class="absolute left-0 right-0 top-[7px] hidden h-0.5 bg-white/15 md:block" aria-hidden="true">
        <span class="path-line block h-full w-full origin-left" style={`background-color:${color}`}></span>
      </span>

      <ol
        class="grid gap-12 md:grid-cols-[repeat(var(--phase-count),minmax(0,1fr))] md:gap-10"
        style={`--phase-count:${phases.length}; --phase-step:${(1 / phases.length).toFixed(3)}`}
      >
        {phases.map((phase, i) => (
          <li class="path-phase" style={`--phase-index:${i}`} data-path-phase>
            <span
              class="relative block h-4 w-4 rounded-full ring-4 ring-stone-900"
              style={`background-color:${color}`}
              aria-hidden="true"
            ></span>
            <p class="mt-6 text-sm font-semibold uppercase tracking-widest" style={`color:${color}`}>
              {String(i + 1).padStart(2, "0")} — {phase.name}
            </p>
            <ul class="mt-5 flex flex-col divide-y divide-white/10 border-t border-white/10">
              {phase.items.map((item) => (
                <li class="py-3 text-base text-white/85">{item}</li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  @media (min-width: 768px) {
    .path-line {
      transform: scaleX(var(--path-p, 1));
    }
    /* Chaque phase apparaît quand la ligne atteint son jalon (index / nombre de phases). */
    .path-phase {
      opacity: clamp(0, calc((var(--path-p, 1) - var(--phase-index) * var(--phase-step)) * 5), 1);
      transform: translateY(calc((1 - clamp(0, calc((var(--path-p, 1) - var(--phase-index) * var(--phase-step)) * 5), 1)) * 16px));
    }
  }
</style>

<script>
  // Progression 0 → 1 pendant que le haut de la section monte de 75 % à 25 % de la hauteur d'écran.
  function update() {
    document.querySelectorAll<HTMLElement>("[data-path]").forEach((section) => {
      const rect = section.getBoundingClientRect();
      const vh = window.innerHeight;
      const p = Math.min(Math.max((vh * 0.75 - rect.top) / (vh * 0.5), 0), 1);
      section.style.setProperty("--path-p", String(p));
    });
  }

  let ticking = false;
  function onScroll() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      ticking = false;
      update();
    });
  }

  window.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("resize", onScroll);
  document.addEventListener("astro:page-load", update);
</script>
