---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import { themes, energyThemeList } from "../data/themes";
import { company, partners } from "../data/company";
import ServiceRail from "../components/ServiceRail.astro";
import LogoMarquee from "../components/LogoMarquee.astro";
import { photoUrl } from "../data/photos";

// Maillage interne complet (SEO) : toutes les pages du site, utilisé en bas de footer — distinct
// de `nav` (header) qui reste volontairement court pour ne pas surcharger la navigation.
const allPages = [
  { href: "/", label: "Accueil" },
  ...energyThemeList.map((t) => ({ href: t.href, label: t.name })),
  { href: "/autoconsommation-collective", label: "Autoconsommation collective" },
  { href: "/societe", label: "Société" },
  { href: "/contact", label: "Contact" },
];

interface Props {
  title: string;
  theme?: keyof typeof themes | "societe";
  description?: string;
  /** Header transparent qui se fond dans la photo, se solidifie au scroll (page d'accueil). */
  transparentHeader?: boolean;
  /** Masque le rail de navigation flottant (ServiceRail) — utile si la page propose déjà sa
   * propre navigation vers les autres filières ailleurs dans son contenu. */
  hideServiceRail?: boolean;
}

const {
  title,
  theme = "societe",
  description = "Cayrol Energie — producteur indépendant d'énergies renouvelables.",
  transparentHeader = false,
  hideServiceRail = false,
} = Astro.props;

// Header : "Nos métiers" ouvre un méga-menu à photos (les 4 filières) ; les autres entrées restent
// des liens simples et Contact sort en bouton plein à droite. La page courante prend la couleur du
// thème (texte + trait sous le lien), et la carte de la filière courante est cerclée dans le menu.
const menuPhotos: Record<string, string> = {
  hydroelectricite: photoUrl("hydroHauteChute", { w: 700 }),
  photovoltaique: "/projets/star-soleil/principale.jpg",
  "flexibilite-bess": photoUrl("bessTerrain", { w: 700 }),
  biogaz: "/images/biogaz/unite-methanisation.jpg",
};
const nav = [
  { href: "/autoconsommation-collective", label: "Court Circuit" },
  { href: "/projets", label: "Projets" },
  { href: "/societe", label: "Société" },
];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
const onEnergyPage = energyThemeList.some((t) => isCurrent(t.href));
---

<html lang="fr" class={`theme-${theme}`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logos/logo-orange.png" />
    <!-- Polices : Open Sans pour tout le texte, Questrial pour le wordmark (.font-brand). Chargées ici
         plutôt qu’en @import CSS, ignoré par le navigateur quand il suit d’autres règles. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300..800&family=Questrial&display=swap"
    />
    <meta name="description" content={description} />
    <title>{title} · Cayrol Energie</title>
    <ClientRouter />
  </head>
  <body
    class="flex min-h-screen flex-col text-neutral-900"
    style="background-color: var(--theme-color-bg);"
  >
    <header
      id="site-header"
      class:list={[
        "fixed inset-x-0 top-0 z-50",
        transparentHeader
          ? "header-transparent border-b border-transparent"
          : "border-b border-black/5 bg-white/90 backdrop-blur",
      ]}
    >
      {!transparentHeader && <div class="h-1 w-full" style="background-color: var(--theme-color);" />}
      <div class="mx-auto flex h-[72px] max-w-7xl items-center justify-between gap-6 px-4">
        <a href="/" class="hdr-text flex shrink-0 items-center" aria-label="Cayrol Energie — accueil">
          <img src="/logos/logo-horizontal-positif-C-removebg-preview.png" alt="Cayrol Energie" class="h-14 w-auto" />
        </a>

        <nav aria-label="Navigation principale" class="hdr-text-muted hidden h-full items-center gap-9 text-[15px] font-medium lg:flex">
          <!-- Ouverture pilotée en JS (survol, clic, clavier) plutôt qu'en :hover CSS pur : avec les
               transitions de page, un menu CSS restait ouvert sous la souris après le clic. -->
          <button
            type="button"
            class="nav-link flex items-center gap-1.5"
            aria-expanded="false"
            aria-controls="mega-panel"
            data-mega-trigger
            data-current={onEnergyPage ? "true" : undefined}
          >
            Nos métiers
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mega-chevron h-3.5 w-3.5" aria-hidden="true">
              <path d="M6 9l6 6 6-6" />
            </svg>
          </button>
          {nav.map((item) => (
            <a href={item.href} class="nav-link" aria-current={isCurrent(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          ))}
        </nav>

        <div class="flex items-center gap-2">
          <a
            href="/contact"
            class="hidden rounded-full px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-transform hover:-translate-y-0.5 sm:inline-block"
            style="background-color: var(--theme-color);"
            aria-current={isCurrent("/contact") ? "page" : undefined}
          >
            Nous contacter
          </a>
          <button
            type="button"
            class="hdr-text -mr-2 flex h-11 w-11 items-center justify-center lg:hidden"
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-label="Ouvrir le menu"
            data-burger
          >
            <span class="burger-lines" aria-hidden="true"><span></span><span></span></span>
          </button>
        </div>
      </div>

      <!-- Méga-menu desktop : les 4 filières en photos, pleine largeur sous le header. -->
      <div id="mega-panel" class="mega-panel absolute inset-x-0 top-full hidden border-t border-black/5 bg-white shadow-[0_24px_48px_-24px_rgb(15_23_42/0.35)] lg:block" data-mega-panel>
        <div class="mx-auto max-w-7xl px-4 pt-6 pb-5">
          <div class="grid grid-cols-4 gap-4">
            {energyThemeList.map((t, i) => (
              <a
                href={t.href}
                class="mega-card group relative block aspect-[4/3] overflow-hidden rounded-2xl"
                style={`--card-color:${t.color}; --i:${i};`}
                aria-current={isCurrent(t.href) ? "page" : undefined}
              >
                <img src={menuPhotos[t.key]} alt="" loading="lazy" class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" />
                <div class="absolute inset-0" style={`background: linear-gradient(to top, color-mix(in srgb, ${t.colorDark}, black 35%) 0%, color-mix(in srgb, ${t.colorDark}, transparent 55%) 45%, transparent 80%);`} />
                <img src={t.logo} alt="" class="absolute top-4 left-4 h-10 w-10 object-contain drop-shadow transition-transform duration-500 group-hover:rotate-12" />
                <div class="absolute inset-x-0 bottom-0 p-5 text-white">
                  <p class="text-xl font-bold tracking-tight">{t.name}</p>
                  <p class="mt-1 text-sm leading-snug text-white/80">{t.tagline}</p>
                </div>
              </a>
            ))}
          </div>
          <div class="mt-4 flex items-center justify-between text-sm text-neutral-500">
            <p>Producteur indépendant d'énergies renouvelables depuis plus de 50 ans.</p>
            <a href="/projets" class="font-semibold text-neutral-900 transition-colors hover:text-[var(--theme-color)]">Voir tous nos projets →</a>
          </div>
        </div>
      </div>

      <!-- Menu mobile / tablette : plein écran sous le header. -->
      <div id="mobile-menu" class="mobile-menu fixed inset-x-0 bottom-0 overflow-y-auto overscroll-contain bg-white lg:hidden" style="top: var(--header-h, 72px);" data-mobile-menu>
        <div class="px-4 pt-5 pb-10">
          <p class="text-xs font-semibold tracking-[0.18em] text-neutral-400 uppercase">Nos métiers</p>
          <div class="mt-3 grid grid-cols-2 gap-3">
            {energyThemeList.map((t) => (
              <a
                href={t.href}
                class="mega-card relative block aspect-[4/3] overflow-hidden rounded-xl"
                style={`--card-color:${t.color};`}
                aria-current={isCurrent(t.href) ? "page" : undefined}
              >
                <img src={menuPhotos[t.key]} alt="" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
                <div class="absolute inset-0" style={`background: linear-gradient(to top, color-mix(in srgb, ${t.colorDark}, black 30%) 0%, transparent 75%);`} />
                <p class="absolute inset-x-0 bottom-0 p-3 text-sm font-bold text-white sm:text-base">{t.name}</p>
              </a>
            ))}
          </div>
          <nav aria-label="Navigation mobile" class="mt-6 flex flex-col border-t border-black/5">
            {[{ href: "/", label: "Accueil" }, ...nav].map((item) => (
              <a
                href={item.href}
                class="mobile-link border-b border-black/5 py-4 text-2xl font-semibold tracking-tight text-neutral-900"
                aria-current={(item.href === "/" ? path === "/" : isCurrent(item.href)) ? "page" : undefined}
              >
                {item.label}
              </a>
            ))}
          </nav>
          <a
            href="/contact"
            class="mt-8 block rounded-full px-6 py-4 text-center text-base font-semibold text-white"
            style="background-color: var(--theme-color);"
          >
            Nous contacter
          </a>
        </div>
      </div>
    </header>

    <main class:list={["flex-1", !transparentHeader && "pt-[var(--header-h,61px)]"]}>
      <slot />
    </main>

    {!hideServiceRail && <ServiceRail />}

    <!-- Footer (retours client : conserver le cadre "discutons de vos projets", partenaires
         défilants, bulle d'infos permanentes, lien Google Maps pour l'adresse, sans rubrique "Nos
         énergies"). Fond à la couleur foncée de l’énergie de la page (--theme-footer, themes.css). -->
    <footer class="text-white" style="background-color: var(--theme-footer);">
      <div class="mx-auto grid max-w-7xl gap-14 px-4 pb-14 pt-16 md:pt-20 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-7">
          <h2 class="text-4xl font-bold !leading-[1.05] tracking-tight md:text-5xl">
            Cayrol Energie vous accompagne dans vos projets d'avenir.
          </h2>
          <p class="mt-6 max-w-xl text-lg text-white/70">
            Un projet de production ou d'autoconsommation d'énergie renouvelable ? Parlons-en.
          </p>
          <a
            href="/contact"
            class="mt-8 inline-flex items-center gap-2 rounded-full bg-white px-7 py-3.5 text-sm font-semibold transition-transform hover:-translate-y-0.5"
            style="color: var(--theme-footer);"
          >
            Discutons de votre projet <span aria-hidden="true">→</span>
          </a>
        </div>

        <dl class="flex flex-col divide-y divide-white/10 border-y border-white/10 lg:col-span-5 lg:self-end">
          <div class="py-5">
            <dt class="text-xs font-semibold uppercase tracking-widest text-white/50">Téléphone</dt>
            <dd class="mt-1.5">
              <a href={`tel:${company.telephone.replace(/[^+\d]/g, "").replace("+330", "+33")}`} class="text-2xl font-semibold transition-colors hover:text-[var(--theme-color-light)]">
                {company.telephone}
              </a>
            </dd>
          </div>
          <div class="py-5">
            <dt class="text-xs font-semibold uppercase tracking-widest text-white/50">Email</dt>
            <dd class="mt-1.5">
              <a href={`mailto:${company.email}`} class="text-2xl font-semibold transition-colors hover:text-[var(--theme-color-light)]">
                {company.email}
              </a>
            </dd>
          </div>
          <div class="py-5">
            <dt class="text-xs font-semibold uppercase tracking-widest text-white/50">Adresse</dt>
            <dd class="mt-1.5">
              <a
                href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(company.adresse)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="group text-lg text-white/85 transition-colors hover:text-[var(--theme-color-light)]"
              >
                {company.adresse}
                <span class="mt-1 block text-sm text-white/50 group-hover:text-[var(--theme-color-light)]">Voir sur Google Maps ↗</span>
              </a>
            </dd>
          </div>
        </dl>
      </div>

      <!-- Partenaires défilants : bande claire au milieu du footer sombre, pour garder les logos
           dans leurs vraies couleurs (reconnaissables, fonds blancs invisibles). -->
      <div class="bg-white py-8 text-slate-900">
        <p class="mx-auto mb-5 max-w-7xl px-4 text-xs font-semibold uppercase tracking-widest text-slate-500">
          Ils nous font confiance
        </p>
        <LogoMarquee items={partners} />
      </div>

      <!-- Infos permanentes Cayrol Energie (retour client) -->
      <div class="border-t border-white/10">
        <dl class="mx-auto grid max-w-7xl gap-8 px-4 py-10 md:grid-cols-3">
          <div>
            <dt class="text-3xl font-bold" style="color: var(--theme-color-light);">+50 ans</dt>
            <dd class="mt-1 text-white/60">d'expérience dans les énergies renouvelables</dd>
          </div>
          <div>
            <dt class="text-3xl font-bold" style="color: var(--theme-color-light);">Ancrage territorial</dt>
            <dd class="mt-1 text-white/60">des projets conçus avec et pour les territoires</dd>
          </div>
          <div>
            <dt class="text-3xl font-bold" style="color: var(--theme-color-light);">Confiance</dt>
            <dd class="mt-1 text-white/60">des partenariats bâtis sur la durée</dd>
          </div>
        </dl>
      </div>

      <!-- Bas de page : marque, plan du site (maillage interne), mentions. -->
      <div class="border-t border-white/10">
        <div class="mx-auto flex max-w-7xl flex-col gap-6 px-4 py-8 md:flex-row md:items-center md:justify-between">
          <a href="/" class="flex items-center gap-3" aria-label="Cayrol Energie, accueil">
            <img src="/logos/sigle-negatif-T-removebg-preview.png" alt="" class="h-9 w-auto" />
            <span class="font-brand text-xl leading-none tracking-wide">
              CAYROL <span class="text-white/60">ENERGIE</span>
            </span>
          </a>
          <nav aria-label="Plan du site" class="flex flex-wrap gap-x-5 gap-y-2 text-sm text-white/50">
            {allPages.map((p) => (
              <a href={p.href} class="transition-colors hover:text-white">{p.label}</a>
            ))}
          </nav>
        </div>
        <div class="mx-auto flex max-w-7xl flex-wrap justify-between gap-2 px-4 pb-8 text-xs text-white/35">
          <p>© {new Date().getFullYear()} Cayrol Energie. Tous droits réservés.</p>
          <p>Prototype de démonstration — contenu et visuels provisoires (voir TODO-CONTENT.md).</p>
        </div>
      </div>
    </footer>

    <script>
      // Hauteur réelle du header (barre de couleur présente ou non selon la page)
      // exposée en variable CSS pour compenser le padding des pages à header opaque.
      function setHeaderHeightVar() {
        const header = document.getElementById("site-header");
        if (header) document.documentElement.style.setProperty("--header-h", `${header.offsetHeight}px`);
      }

      let scrollHandler: (() => void) | null = null;

      // Réexécuté à chaque navigation (y compris le premier chargement) grâce à astro:page-load,
      // pour que le header transparent + scroll-to-solid fonctionnent avec les transitions de page.
      function initHeader() {
        setHeaderHeightVar();
        const header = document.getElementById("site-header");
        if (scrollHandler) {
          document.removeEventListener("scroll", scrollHandler);
          scrollHandler = null;
        }
        if (header?.classList.contains("header-transparent")) {
          scrollHandler = () => header.classList.toggle("is-scrolled", window.scrollY > 40);
          document.addEventListener("scroll", scrollHandler, { passive: true });
          scrollHandler();
        }
      }

      // Méga-menu "Nos métiers" (desktop) : ouvert au survol du bouton ou du panneau (fermeture
      // légèrement différée pour traverser l'espace entre les deux), au clic (tactile) et au clavier.
      // Le header est re-rendu à chaque navigation, donc on rebranche les écouteurs à chaque page.
      let closeTimer: number | undefined;

      function setMega(open: boolean) {
        const header = document.getElementById("site-header");
        const trigger = header?.querySelector<HTMLElement>("[data-mega-trigger]");
        if (!header || !trigger) return;
        window.clearTimeout(closeTimer);
        header.classList.toggle("mega-open", open);
        trigger.setAttribute("aria-expanded", String(open));
      }

      function setMobileMenu(open: boolean) {
        const header = document.getElementById("site-header");
        const burger = header?.querySelector<HTMLElement>("[data-burger]");
        if (!header || !burger) return;
        header.classList.toggle("mobile-open", open);
        burger.setAttribute("aria-expanded", String(open));
        burger.setAttribute("aria-label", open ? "Fermer le menu" : "Ouvrir le menu");
        // Bloque le défilement de la page derrière le menu (et Lenis, qui écoute la molette).
        document.documentElement.style.overflow = open ? "hidden" : "";
        const lenis = (window as Window & { __lenis?: { stop(): void; start(): void } }).__lenis;
        if (open) lenis?.stop();
        else lenis?.start();
      }

      function initMenus() {
        const header = document.getElementById("site-header");
        const trigger = header?.querySelector<HTMLElement>("[data-mega-trigger]");
        const panel = header?.querySelector<HTMLElement>("[data-mega-panel]");
        const burger = header?.querySelector<HTMLElement>("[data-burger]");
        if (!header || !trigger || !panel) return;

        const open = () => setMega(true);
        const closeSoon = () => {
          window.clearTimeout(closeTimer);
          closeTimer = window.setTimeout(() => setMega(false), 140);
        };
        for (const el of [trigger, panel]) {
          el.addEventListener("pointerenter", (e) => e.pointerType === "mouse" && open());
          el.addEventListener("pointerleave", (e) => e.pointerType === "mouse" && closeSoon());
        }
        // À la souris, le survol a déjà ouvert le menu : le clic ne doit pas le refermer aussitôt.
        trigger.addEventListener("click", (e) =>
          setMega((e as PointerEvent).pointerType === "mouse" || !header.classList.contains("mega-open")),
        );
        header.addEventListener("focusout", (e) => {
          const next = e.relatedTarget as Node | null;
          if (!next || (!trigger.contains(next) && !panel.contains(next))) setMega(false);
        });
        burger?.addEventListener("click", () => setMobileMenu(!header.classList.contains("mobile-open")));
      }

      document.addEventListener("keydown", (e) => {
        if (e.key !== "Escape") return;
        const header = document.getElementById("site-header");
        if (header?.classList.contains("mega-open")) {
          setMega(false);
          header.querySelector<HTMLElement>("[data-mega-trigger]")?.focus();
        }
        if (header?.classList.contains("mobile-open")) setMobileMenu(false);
      });
      document.addEventListener("click", (e) => {
        const header = document.getElementById("site-header");
        if (header?.classList.contains("mega-open") && !header.contains(e.target as Node)) setMega(false);
      });
      // Le menu mobile se referme avant la navigation (sinon le défilement resterait bloqué).
      document.addEventListener("astro:before-swap", () => {
        document.documentElement.style.overflow = "";
        (window as Window & { __lenis?: { start(): void } }).__lenis?.start();
      });

      window.addEventListener("resize", setHeaderHeightVar);
      document.addEventListener("astro:page-load", initHeader);
      document.addEventListener("astro:page-load", initMenus);
    </script>

    <script>
      // Défilement fluide sur tout le site (Lenis) : même distance par cran de molette qu'en natif
      // (WHEEL_MULTIPLIER = 1, le standard), lissée avec une légère inertie. Le tactile
      // garde le défilement natif (option par défaut de Lenis). Désactivé si l'utilisateur a
      // demandé moins d'animations. Les ancres (#…) défilent aussi via Lenis.
      // Exposé sur window.__lenis : les heros qui calibraient eux-mêmes la molette (AnimatedHero,
      // accueil) s'effacent quand Lenis est actif.
      import Lenis from "lenis";
      import "lenis/dist/lenis.css";

      const WHEEL_MULTIPLIER = 1;
      const LERP = 0.12;

      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const lenis = new Lenis({ wheelMultiplier: WHEEL_MULTIPLIER, lerp: LERP, anchors: true, autoRaf: true });
        (window as Window & { __lenis?: Lenis }).__lenis = lenis;
        // Navigation ClientRouter : la nouvelle page repart de sa propre position (haut de page ou
        // position restaurée au retour arrière) sans inertie résiduelle de la page précédente.
        document.addEventListener("astro:after-swap", () => {
          lenis.scrollTo(window.scrollY, { immediate: true, force: true });
          lenis.resize();
        });
      }
    </script>
  </body>
</html>
