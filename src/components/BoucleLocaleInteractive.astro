---
// Démonstrateur "boucle locale" de l'autoconsommation collective : dashboard split (colonne de
// contrôle + schéma) où un hub énergétique central alimente 4 bâtiments participants disposés en
// V asymétrique autour de lui. Le slider horaire pilote en direct la vitesse des flux d'énergie,
// l'état actif/inactif de chaque bâtiment et un panel de télémétrie (production / consommation /
// autarcie) — 100% natif SVG/CSS/JS (pas de librairie de charting) pour rester léger et garder un
// rendu net à toute résolution via viewBox.
// Look "SaaS B2B light / dashboard institutionnel" : fond clair, cartes blanches à ombre douce,
// câbles bleus avec particules animées (<animateMotion>, pas de gros tirets).
// Les bâtiments et le hub sont des cartes HTML positionnées en overlay au-dessus du SVG (qui ne
// porte que le fond quadrillé, les câbles et les particules) : un box-shadow / border-radius de
// carte se rend proprement en HTML, pas en SVG pur.

export type BuildingKind = "mairie" | "industrie" | "residentiel" | "commerce";

export interface Node {
  id: BuildingKind;
  label: string;
  x: number; // position en % de la largeur du schéma (disposition organique, pas une croix parfaite)
  y: number; // position en % de la hauteur du schéma
  kwc: number; // puissance de raccordement installée (kWc)
  detail: string;
}

const nodes: Node[] = [
  { id: "mairie", label: "Mairie / Écoles", x: 20, y: 22, kwc: 18, detail: "12 bâtiments publics raccordés" },
  { id: "industrie", label: "Zone industrielle", x: 80, y: 16, kwc: 64, detail: "6 entreprises raccordées" },
  { id: "residentiel", label: "Quartier résidentiel", x: 16, y: 76, kwc: 31, detail: "140 foyers raccordés" },
  { id: "commerce", label: "Centre commercial", x: 82, y: 70, kwc: 22, detail: "9 commerces raccordés" },
];

const HUB = { x: 50, y: 46 };

// Icône SVG dédiée par type de bâtiment (viewBox 0 0 24 24, tracé uniquement — la couleur vient
// de currentColor pour suivre l'état actif/inactif de la carte parente).
const BUILDING_ICONS: Record<BuildingKind, string> = {
  // Bâtiment institutionnel à colonnes (fronton + colonnade + degrés).
  mairie:
    "M3 10.5 12 4l9 6.5M4.5 10.5v8M7.5 10.5v8M10.5 10.5v8M13.5 10.5v8M16.5 10.5v8M19.5 10.5v8M2.5 18.5h19M3 21h18",
  // Usine : toiture en dents de scie + cheminée.
  industrie:
    "M3 20V12l4 3v-3l4 3v-3l4 3v-6h2v-3.2M3 20h18M3 12h4M17 8.8V5h2v3.8M6 20v-4h3v4M13 20v-3h3v3",
  // Groupe d'habitations : deux toits pignon superposés.
  residentiel:
    "M3 20v-7.2L8 9l5 3.8V20M3 20h10M6 20v-4h4v4M13 20v-9.6L17.5 7l3.5 3.4V20M13 20h8M16.2 20v-3.4h2.6V20",
  // Grand bâtiment commercial : façade vitrée + auvent.
  commerce:
    "M3 9.5 12 4l9 5.5M4 9.5v10.5M20 9.5v10.5M4 20h16M7.5 20v-6h3v6M13.5 20v-6h3v6M4 9.5h16",
};

// Le profil horaire de consommation par type de bâtiment vit uniquement côté <script> (runtime) :
// c'est la seule grandeur qui doit rester identique entre affichage et panel de télémétrie, donc
// une seule définition plutôt que de la dupliquer ici en plus.
---

<section class="boucle-locale not-prose" aria-label="Simulation interactive de la boucle locale d'autoconsommation collective">
  <div class="boucle-locale__grid">
    <div class="boucle-locale__control">
      <div>
        <h3 class="boucle-locale__title">Boucle locale — suivi temps réel</h3>
        <p class="boucle-locale__subtitle">
          Faites glisser le curseur pour simuler une journée de production et voir la répartition de
          l'électricité entre les participants de la boucle.
        </p>
      </div>

      <div class="boucle-locale__timeline">
        <div class="boucle-locale__timeline-track">
          <span class="boucle-locale__time-pill" id="boucle-time-pill">11h00 &middot; Pic de production</span>
          <input
            type="range"
            id="boucle-time"
            class="boucle-locale__slider"
            min="6"
            max="21"
            step="0.5"
            value="11"
            aria-label="Heure de la journée"
          />
        </div>
        <div class="boucle-locale__ticks" aria-hidden="true">
          {[6, 9, 12, 15, 18, 21].map((h) => (
            <span class="boucle-locale__tick" style={`left:${((h - 6) / 15) * 100}%`}>
              {String(h).padStart(2, "0")}h
            </span>
          ))}
        </div>
      </div>

      <div class="boucle-locale__metrics" role="status" aria-live="polite">
        <div class="boucle-locale__metric">
          <span class="boucle-locale__metric-icon boucle-locale__metric-icon--amber" aria-hidden="true"></span>
          <div>
            <span class="boucle-locale__metric-label">Production solaire</span>
            <span class="boucle-locale__metric-value boucle-locale__metric-value--amber"><span id="metric-production">0</span> kW</span>
          </div>
        </div>
        <div class="boucle-locale__metric">
          <span class="boucle-locale__metric-icon boucle-locale__metric-icon--blue" aria-hidden="true"></span>
          <div>
            <span class="boucle-locale__metric-label">Consommation boucle</span>
            <span class="boucle-locale__metric-value boucle-locale__metric-value--blue"><span id="metric-consumption">0</span> kW</span>
          </div>
        </div>
        <div class="boucle-locale__metric">
          <span class="boucle-locale__metric-icon boucle-locale__metric-icon--green" aria-hidden="true"></span>
          <div>
            <span class="boucle-locale__metric-label">Taux d'autarcie</span>
            <span class="boucle-locale__metric-value boucle-locale__metric-value--green"><span id="metric-autarky">0</span> %</span>
          </div>
        </div>
      </div>
    </div>

    <div class="boucle-locale__diagram">
      <div class="boucle-locale__svg-wrap">
        <svg viewBox="0 0 100 100" class="boucle-locale__svg" role="img" aria-hidden="true" preserveAspectRatio="none">
          <defs>
            <pattern id="territoryGrid" width="5" height="5" patternUnits="userSpaceOnUse">
              <path d="M5 0H0V5" fill="none" stroke="#e2e8f0" stroke-width="0.15" />
            </pattern>
          </defs>

          {/* Filigrane de territoire, discret */}
          <rect x="0" y="0" width="100" height="100" fill="url(#territoryGrid)" opacity="0.5" />

          {/* Câbles hub -> chaque bâtiment : mêmes coordonnées en % que les cartes HTML
              (viewBox 0 0 100 100 + preserveAspectRatio="none" épouse exactement le conteneur),
              donc pas de dérive entre le tracé SVG et les cartes positionnées en left/top CSS. */}
          {nodes.map((n) => (
            <line x1={HUB.x} y1={HUB.y} x2={n.x} y2={n.y} class="boucle-locale__cable" data-cable={n.id} />
          ))}

          {/* Disque plein sous la carte HTML du hub : recouvre proprement le départ des 4 câbles */}
          <circle cx={HUB.x} cy={HUB.y} r="6" class="boucle-locale__hub-mask" />
        </svg>

        {/* Particules de flux : divs HTML (jamais déformés, contrairement à un <circle> SVG dans
            un viewBox non-carré étiré par preserveAspectRatio="none") positionnées en % et
            animées le long du même segment hub -> bâtiment que le câble SVG jumeau. */}
        {nodes.map((n, i) => (
          <span
            class="boucle-locale__particle"
            data-particle={n.id}
            style={`--bl-hub-x:${HUB.x}%; --bl-hub-y:${HUB.y}%; --bl-node-x:${n.x}%; --bl-node-y:${n.y}%; animation-delay:${i * -0.7}s`}
          />
        ))}

        {/* Hub énergétique, carte HTML au centre du schéma */}
        <div
          class="boucle-locale__hub"
          id="boucle-hub"
          style={`left:${HUB.x}%; top:${HUB.y}%`}
          tabindex="0"
          role="img"
          aria-label="Hub énergétique Cayrol Energie, nœud central de production"
        >
          <span class="boucle-locale__hub-glow" id="boucle-hub-glow" aria-hidden="true"></span>
          <svg viewBox="0 0 26 28" class="boucle-locale__hub-icon" aria-hidden="true">
            <rect x="1" y="1" width="24" height="16" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.6" />
            <path d="M9 1v16M17 1v16M1 6.3h24M1 11.7h24" stroke="currentColor" stroke-width="1" opacity="0.7" />
            <path d="M13 17v4M8 26h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
          <span class="boucle-locale__hub-label">Hub énergétique</span>
        </div>

        {/* Bâtiments participants, cartes HTML positionnées de façon organique */}
        {nodes.map((n) => (
          <div
            class="boucle-locale__node"
            style={`left:${n.x}%; top:${n.y}%`}
            tabindex="0"
            role="img"
            aria-label={`${n.label} — ${n.detail}, ${n.kwc} kWc raccordés`}
            data-node={n.id}
            data-label={n.label}
            data-detail={n.detail}
            data-kwc={n.kwc}
          >
            <span class="boucle-locale__node-icon-wrap">
              <svg viewBox="0 0 24 24" class="boucle-locale__node-icon" aria-hidden="true">
                <path
                  d={BUILDING_ICONS[n.id]}
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
            <span class="boucle-locale__node-label">{n.label}</span>
            <span class="boucle-locale__node-kw" data-node-kw={n.id}>0 kW</span>
          </div>
        ))}

        {/* Tooltip flottant positionné en JS au survol/focus d'un nœud */}
        <div class="boucle-locale__tooltip" id="boucle-tooltip" role="tooltip" hidden>
          <p class="boucle-locale__tooltip-title" id="boucle-tooltip-title"></p>
          <p class="boucle-locale__tooltip-stat" id="boucle-tooltip-stat"></p>
        </div>
      </div>

      <p class="boucle-locale__caption">
        Simulation illustrative — les volumes réels dépendent de l'ensoleillement et de la clé de répartition
        contractuelle.
      </p>
    </div>
  </div>
</section>

<style>
