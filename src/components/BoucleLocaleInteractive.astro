</style>

<script>
  // Modèle horaire illustratif : la production suit une cloche solaire centrée sur midi (nulle
  // avant 7h/après 20h) ; chaque bâtiment a son propre profil de consommation. Une seule source
  // de vérité par grandeur plutôt que dupliquer le calcul entre affichage et panel de télémétrie.
  function productionRatioAt(hour: number): number {
    if (hour <= 7 || hour >= 20) return 0;
    const peak = 13;
    const spread = 6.5;
    const ratio = Math.exp(-((hour - peak) ** 2) / (2 * spread * spread));
    return Math.max(0, Math.min(1, ratio));
  }

  const CONSUMPTION_PROFILE: Record<string, (hour: number) => number> = {
    mairie: (h) => (h >= 8 && h <= 18 ? 0.55 + 0.35 * Math.exp(-((h - 13) ** 2) / (2 * 4 * 4)) : 0.12),
    industrie: (h) => (h >= 6 && h <= 20 ? 0.7 + 0.2 * Math.sin(((h - 6) / 14) * Math.PI) : 0.25),
    residentiel: (h) => {
      const morning = Math.exp(-((h - 8) ** 2) / (2 * 1.6 * 1.6));
      const evening = Math.exp(-((h - 20) ** 2) / (2 * 2.2 * 2.2));
      return 0.25 + 0.65 * Math.max(morning, evening);
    },
    commerce: (h) => (h >= 9 && h <= 20 ? 0.5 + 0.4 * Math.exp(-((h - 16) ** 2) / (2 * 4 * 4)) : 0.1),
  };

  function formatHour(hour: number): string {
    const h = Math.floor(hour);
    const m = hour % 1 === 0 ? "00" : "30";
    return `${h}h${m}`;
  }

  function statusLabelAt(hour: number, ratio: number): string {
    const h = formatHour(hour);
    if (ratio < 0.03) return `${h} · Relais Enedis`;
    if (ratio < 0.35) return `${h} · Production partielle`;
    if (ratio < 0.85) return `${h} · Montée en production`;
    return `${h} · Pic de production`;
  }

  function initBoucleLocale(root: Element) {
    const slider = root.querySelector<HTMLInputElement>("#boucle-time");
    const timePill = root.querySelector<HTMLElement>("#boucle-time-pill");
    const grid = root.querySelector<HTMLElement>(".boucle-locale__grid");
    const metricProduction = root.querySelector<HTMLElement>("#metric-production");
    const metricConsumption = root.querySelector<HTMLElement>("#metric-consumption");
    const metricAutarky = root.querySelector<HTMLElement>("#metric-autarky");
    const tooltip = root.querySelector<HTMLElement>("#boucle-tooltip");
    const tooltipTitle = root.querySelector<HTMLElement>("#boucle-tooltip-title");
    const tooltipStat = root.querySelector<HTMLElement>("#boucle-tooltip-stat");
    const svgWrapEl = root.querySelector<HTMLElement>(".boucle-locale__svg-wrap");
    const nodeEls = Array.from(root.querySelectorAll<HTMLElement>("[data-node]"));

    if (
      !slider ||
      !timePill ||
      !grid ||
      !metricProduction ||
      !metricConsumption ||
      !metricAutarky ||
      !svgWrapEl ||
      nodeEls.length === 0
    ) {
      return;
    }
    const svgWrap: HTMLElement = svgWrapEl;
    const gridEl: HTMLElement = grid;
    const timePillEl: HTMLElement = timePill;
    const metricProductionEl: HTMLElement = metricProduction;
    const metricConsumptionEl: HTMLElement = metricConsumption;
    const metricAutarkyEl: HTMLElement = metricAutarky;
    const sliderEl: HTMLInputElement = slider;

    // Puissance de production totale de la centrale : somme des kWc raccordés (le hub peut
    // fournir jusqu'à la totalité de ce que la boucle consomme au même instant).
    const totalInstalledKwc = nodeEls.reduce((sum, node) => sum + Number(node.dataset.kwc ?? 0), 0);
    const sliderMin = parseFloat(sliderEl.min);
    const sliderMax = parseFloat(sliderEl.max);

    function update() {
      const hour = parseFloat(sliderEl.value);
      const productionRatio = productionRatioAt(hour);
      const productionKw = totalInstalledKwc * productionRatio;

      gridEl.style.setProperty("--bl-flow-opacity", `${0.2 + productionRatio * 0.7}`);
      gridEl.style.setProperty("--bl-hub-intensity", `${0.15 + productionRatio * 0.85}`);
      // Vitesse du flux : ~1.4s au pic de midi, jusqu'à ~4s quand la production est nulle.
      gridEl.style.setProperty("--bl-flow-duration", `${(4 - productionRatio * 2.6).toFixed(2)}s`);

      const thumbPos = ((hour - sliderMin) / (sliderMax - sliderMin)) * 100;
      gridEl.style.setProperty("--bl-thumb-pos", `${thumbPos}%`);
      timePillEl.textContent = statusLabelAt(hour, productionRatio);

      let totalConsumptionKw = 0;
      nodeEls.forEach((node) => {
        const kind = node.dataset.node ?? "";
        const kwc = Number(node.dataset.kwc ?? 0);
        const profile = CONSUMPTION_PROFILE[kind];
        const consumptionRatio = profile ? profile(hour) : 0;
        const consumptionKw = kwc * consumptionRatio;
        totalConsumptionKw += consumptionKw;

        const active = consumptionRatio >= 0.35;
        node.dataset.active = String(active);
        const kwLabel = node.querySelector<HTMLElement>("[data-node-kw]");
        if (kwLabel) kwLabel.textContent = `${consumptionKw.toFixed(1)} kW`;
      });

      const autarky = totalConsumptionKw > 0 ? Math.min(100, (productionKw / totalConsumptionKw) * 100) : 0;

      metricProductionEl.textContent = productionKw.toFixed(1);
      metricConsumptionEl.textContent = totalConsumptionKw.toFixed(1);
      metricAutarkyEl.textContent = autarky.toFixed(0);
    }

    sliderEl.addEventListener("input", update);
    update();

    function showTooltip(node: HTMLElement) {
      if (!tooltip || !tooltipTitle || !tooltipStat) return;
      const label = node.getAttribute("data-label") ?? "";
      const detail = node.getAttribute("data-detail") ?? "";
      const kwc = node.getAttribute("data-kwc") ?? "";
      tooltipTitle.textContent = label;
      tooltipStat.textContent = `${detail} · ${kwc} kWc installés`;

      const wrapRect = svgWrap.getBoundingClientRect();
      const nodeRect = node.getBoundingClientRect();
      const x = nodeRect.left + nodeRect.width / 2 - wrapRect.left;
      const y = nodeRect.top - wrapRect.top;
      tooltip.style.left = `${x}px`;
      tooltip.style.top = `${y}px`;
      tooltip.hidden = false;
      requestAnimationFrame(() => tooltip.classList.add("is-visible"));
    }

    function hideTooltip() {
      if (!tooltip) return;
      tooltip.classList.remove("is-visible");
      window.setTimeout(() => {
        if (!tooltip.classList.contains("is-visible")) tooltip.hidden = true;
      }, 150);
    }

    nodeEls.forEach((node) => {
      node.addEventListener("mouseenter", () => showTooltip(node));
      node.addEventListener("mouseleave", hideTooltip);
      node.addEventListener("focus", () => showTooltip(node));
      node.addEventListener("blur", hideTooltip);
    });
  }

  function initAllBoucleLocale() {
    document.querySelectorAll(".boucle-locale").forEach((root) => initBoucleLocale(root));
  }

  initAllBoucleLocale();
  document.addEventListener("astro:page-load", initAllBoucleLocale);
</script>
