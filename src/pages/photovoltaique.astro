---
import BaseLayout from "../layouts/BaseLayout.astro";
import AnimatedHero from "../components/AnimatedHero.astro";
import OrganicImageHero from "../components/OrganicImageHero.astro";
import ThematicTab from "../components/ThematicTab.tsx";
import ScrollStepGallery from "../components/ScrollStepGallery.tsx";
import { themes } from "../data/themes";
import { photoUrl } from "../data/photos";
import { company } from "../data/company";
import projects from "../data/projects.json";

const theme = themes.photovoltaique;

// Contenu repris de la maquette client retour_site_internet/cayrol-photovoltaique.html (textes issus
// de cayrolenergie.com) : accroche, chiffres clés, paragraphe métier, descriptions des 4 types,
// sélection de projets et bandeau de contact. La structure de la page reste la nôtre pour l'instant.
const keyFigures = [
  { value: 64, suffix: "", label: "centrales photovoltaïques en exploitation" },
  { value: 50, suffix: "+", label: "années d'expertise en énergies renouvelables" },
  { value: 3, suffix: "", label: "générations à la tête d'une entreprise familiale" },
  { value: 2, suffix: "", label: "départements d'ancrage territorial — 73 & 34" },
];

const isType = (p: (typeof projects)[number], keyword: string) => p.type.toLowerCase().includes(keyword);

// Sélection de réalisations de la maquette client, dans son ordre.
// TODO-CONTENT : aucun projet "Au sol" ni "Agrivoltaïsme" dans les données fournies — à compléter par le client.
const FEATURED_IDS = ["star-soleil", "bramafan", "besseges", "aiton", "la-chambre", "sauvian"];
const featuredProjects = FEATURED_IDS.map((id) => projects.find((p) => p.id === id)!);

// Chaque carte "showcase" affiche la photo de la catégorie du projet (pas de photo par site
// individuel dans les données actuelles) — cohérent avec les mêmes visuels que la grille
// "Nos types d'installations" juste au-dessus, pour ne pas introduire une 3ᵉ source d'images.
// Star Soleil a en plus une fiche détaillée en démo (photos + description complète) : voir
// src/pages/projets/star-soleil.astro — les autres projets restent de simples encarts.
const toProject = (p: (typeof projects)[number]) => ({
  name: p.name,
  commune: p.commune,
  power: p.power,
  description: p.description,
  image: isType(p, "toiture") ? photoUrl("pvToiture", { w: 900 }) : photoUrl("pvOmbrieres", { w: 900 }),
  tags: [p.type, p.power],
  href: p.id === "star-soleil" ? "/projets/star-soleil" : undefined,
});

const timelineSteps = [
  { date: "M0", label: "Étude de faisabilité", description: "Analyse technique et administrative du site." },
  { date: "M+2", label: "Dépôt du permis de construire", description: "Constitution et dépôt du dossier." },
  { date: "M+6", label: "Instruction & raccordement", description: "Instruction du permis, demande de raccordement au réseau." },
  { date: "M+9", label: "Construction", description: "Installation des panneaux et du poste de livraison." },
  { date: "M+10", label: "Mise en service", description: "Raccordement au réseau et démarrage de la production." },
];

// Même déroulé que timelineSteps, avec une photo par étape pour la démo ScrollStepGallery —
// TODO-CONTENT : réemploi des 4 photos de catégories + la photo hero faute de photos dédiées à
// chaque étape du chantier dans les données actuelles ; à remplacer par de vraies photos de
// chantier (étude terrain, dépôt de dossier, tranchée de raccordement, pose des panneaux, mise en
// service) si le client peut en fournir.
const scrollGallerySteps = [
  { ...timelineSteps[0], image: photoUrl("pvAuSol", { w: 1400 }), icon: "idea" as const },
  { ...timelineSteps[1], image: photoUrl("heroAccueil", { w: 1400 }), icon: "building" as const },
  { ...timelineSteps[2], image: photoUrl("pvOmbrieres", { w: 1400 }), icon: "bolt" as const },
  { ...timelineSteps[3], image: photoUrl("pvToiture", { w: 1400 }), icon: "shield" as const },
  { ...timelineSteps[4], image: photoUrl("pvAgrivoltaisme", { w: 1400 }), icon: "chart" as const },
];
---

<BaseLayout title="Photovoltaïque" theme="photovoltaique" hideServiceRail>
  <!-- Même hero que Hydro / Biogaz / BESS (retour : harmoniser les pages métiers) : titre coloré
       au scroll, photo découpée avec le logo dans l'encoche (bas-droite pour le photovoltaïque),
       chiffres clés animés à l'arrivée sur la page. -->
  <AnimatedHero
    heroId="pv-hero"
    eyebrow={theme.name}
    title="Valoriser chaque toiture, chaque parking, chaque terrain inexploité."
    color={theme.color}
  >
    <Fragment slot="lead">
      <p class="mt-4 text-sm leading-relaxed text-slate-600 md:text-base">
        En source d'énergie renouvelable, à taille humaine : 64 centrales photovoltaïques conçues sur-mesure depuis
        nos premières installations.
      </p>

      <div class="mt-8 grid grid-cols-2 gap-x-6 gap-y-5">
        {keyFigures.map((f) => (
          <div>
            <p class="text-3xl font-extrabold" style={`color:${theme.color}`} data-countup={f.value} data-suffix={f.suffix}>
              {f.value}{f.suffix}
            </p>
            <p class="text-sm text-slate-500">{f.label}</p>
          </div>
        ))}
      </div>
    </Fragment>

    <OrganicImageHero
      slot="image"
      src={photoUrl("pvAuSol", { w: 1800 })}
      alt="Centrale photovoltaïque au sol"
      logo={theme.logo}
      variant="tab"
      class="h-[340px] w-full sm:h-[420px] md:h-[520px] lg:h-[min(680px,calc(100vh-var(--header-h,61px)-4rem))]"
    />
  </AnimatedHero>

  <section id="realisations">
  <div class="mx-auto max-w-7xl px-4 py-14">
    <ThematicTab
      client:visible
      color={theme.color}
      explanations={[
        {
          title: "Un savoir-faire photovoltaïque intégré",
          body: "Cayrol Energie conçoit, construit et exploite des installations photovoltaïques adaptées à chaque foncier — toiture ou hangar agricole, ombrière de parking, centrale au sol ou projet agrivoltaïque. Nous intervenons depuis la prospection et la conception jusqu'à la mise en production, en travaillant avec plusieurs fournisseurs pour retenir la meilleure technologie selon chaque projet. Chaque installation est pensée en intégrant les enjeux locaux dès l'origine, pour s'inscrire durablement dans son environnement et générer une synergie avec l'activité du site. Une équipe dédiée assure ensuite un suivi quotidien de la production et des visites régulières, pour une exploitation fiable sur le long terme — l'esprit d'une entreprise familiale, à taille humaine, depuis trois générations.",
        },
      ]}
      categories={[
        {
          label: "Toiture",
          image: photoUrl("pvToiture", { w: 1400 }),
          description: "Toitures et hangars agricoles ou industriels équipés sans emprise au sol supplémentaire.",
          href: "/photovoltaique/toiture",
          transitionName: "pv-type-toiture",
        },
        {
          label: "Ombrières",
          image: photoUrl("pvOmbrieres", { w: 1400 }),
          description: "Couvrez vos parkings et protégez vos visiteurs tout en produisant de l'énergie.",
          href: "/photovoltaique/ombrieres",
          transitionName: "pv-type-ombrieres",
        },
        {
          label: "Au sol",
          image: photoUrl("pvAuSol", { w: 1400 }),
          description: "Terrains dégradés, friches ou carrières valorisés en source d'énergie renouvelable.",
          href: "/photovoltaique/sol",
          transitionName: "pv-type-sol",
        },
        {
          label: "Agrivoltaïsme",
          image: photoUrl("pvAgrivoltaisme", { w: 1400 }),
          description: "Serres et persiennes photovoltaïques pour protéger les cultures et produire de l'énergie.",
          href: "/photovoltaique/agrivoltaisme",
          transitionName: "pv-type-agrivoltaisme",
        },
      ]}
      categoriesIntro="Quatre façons de valoriser un foncier en source d'énergie renouvelable — chacune fait l'objet d'une page dédiée."
      timelineSteps={timelineSteps}
      timelineVariant="dots"
      timelineIntro="De l'étude de faisabilité à la mise en service, cinq grandes étapes structurent chaque projet."
      projects={featuredProjects.map(toProject)}
      projectsIntro="Quelques réalisations, du dossier à la mise en service."
      projectsLayout="showcase-carousel"
    />

    <p class="mt-10 text-sm text-neutral-500">
      TODO-CONTENT : les catégories "Au sol" et "Agrivoltaïsme" n'ont pas d'exemple dans les données transmises —
      merci de fournir 2 projets par catégorie pour compléter cette page. Par ailleurs, une page dédiée "Hangar
      photovoltaïque" existe déjà (contenu du docx client intégré, voir /photovoltaique/hangar) mais n'a pas
      encore de carte dans la grille ci-dessus — cette grille reste à 4 cases (Hangar fondu dans Toiture) en
      attendant une décision du client sur la 5ᵉ catégorie (voir TODO-CONTENT.md).
    </p>
  </div>
  </section>

  <!-- Déroulé d'un projet type, variante scroll immersif façon business.nrg.com — posée en plus
       de la frise "dots" ci-dessus (dans ThematicTab) le temps de comparer les deux rendus. -->
  <section class="border-t border-slate-200/80 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-14">
      <h2 class="mb-2 text-2xl font-bold text-neutral-900">Déroulement d'un projet type (variante scroll)</h2>
      <p class="mb-10 text-neutral-600">De l'étude de faisabilité à la mise en service, cinq grandes étapes structurent chaque projet.</p>
      <ScrollStepGallery client:visible steps={scrollGallerySteps} color={theme.color} />
    </div>
  </section>

  <!-- Bandeau de contact (maquette client) -->
  <section class="bg-orange-600 text-white">
    <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-6 px-4 py-12 md:flex-row md:items-center">
      <div>
        <h2 class="text-2xl font-bold md:text-3xl">Un projet photovoltaïque en tête ?</h2>
        <p class="mt-2 text-white/85">Parlons-en — un interlocuteur unique vous accompagne de l'étude à la mise en service.</p>
      </div>
      <a
        href="tel:+33467494570"
        class="shrink-0 rounded-full bg-white px-6 py-3 text-sm font-semibold text-orange-700 shadow-sm transition-transform hover:-translate-y-0.5"
      >
        {company.telephone}
      </a>
    </div>
  </section>
</BaseLayout>
