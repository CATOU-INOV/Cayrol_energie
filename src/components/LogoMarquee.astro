---
// Bandeau "Ils nous font confiance" à défilement infini (pure CSS, pas de JS/hydratation).
// Le contenu est dupliqué une fois et translaté de -50% : boucle parfaitement continue quel
// que soit le nombre d'éléments, sans calcul de largeur en dur (espacement porté par chaque
// élément plutôt que par un gap, pour que la jonction entre les deux copies soit identique).
// Logos en couleurs réelles (légèrement atténués, pleine couleur au survol) sur fond clair :
// les partenaires restent reconnaissables et les logos à fond blanc s'y fondent. Un partenaire
// sans logo fourni n'apparaît pas dans le bandeau.

import type { Partner } from "../data/company";

interface Props {
  items: Partner[];
}

const { items } = Astro.props;
// Seuls les partenaires dont le logo est fourni sont affichés (pas de nom en texte dans le bandeau).
const withLogo = items.filter((partner) => partner.logo);
const looped = [...withLogo, ...withLogo];
---

<div class="marquee-mask relative overflow-hidden">
  <ul class="marquee-track flex w-max items-center py-2">
    {looped.map((partner, i) => (
      <li class="flex h-20 shrink-0 items-center pr-16" aria-hidden={i >= withLogo.length ? "true" : undefined}>
        <img
          src={partner.logo}
          alt={partner.name}
          loading="lazy"
          class:list={[partner.compact ? "h-20" : "h-14", "w-auto max-w-44 object-contain opacity-80 saturate-[.85] transition duration-300 hover:opacity-100 hover:saturate-100"]}
        />
      </li>
    ))}
  </ul>
</div>
