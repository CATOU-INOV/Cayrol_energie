---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ContainerScroll } from "../components/ContainerScroll.tsx";
import FilieresMosaic from "../components/FilieresMosaic.tsx";
import { HeroParallax } from "../components/HeroParallax.tsx";
import ScrollProjectMap from "../components/ScrollProjectMap.tsx";
import ThemeSelector from "../components/ThemeSelector.tsx";
import EnergyShowcase from "../components/EnergyShowcase.tsx";
import PetalArc from "../components/PetalArc.tsx";
import LogoMarquee from "../components/LogoMarquee.astro";
import BrandPattern from "../components/BrandPattern.astro";
import { photoUrl } from "../data/photos";
import { energyThemeList, themes, type ThemeKey } from "../data/themes";
import projects from "../data/projects.json";

const ENERGY_TO_THEME: Record<string, ThemeKey> = {
  photovoltaique: "photovoltaique",
  hydroelectricite: "hydroelectricite",
  "flexibilite-bess": "flexibilite-bess",
  biogaz: "biogaz",
  hybride: "photovoltaique",
};

// Dédoublonne par commune (le composant présente une carte, pas une liste exhaustive de sites —
// Bramafan/Argentine apparaît deux fois dans projects.json, TODO-CONTENT probablement une entrée
// à corriger côté données) et ne garde que les champs utiles au scrollytelling.
const dedupedProjects = Array.from(new Map(projects.map((p) => [p.commune, p])).values());

// DEMO — TODO-CONTENT : les projets #5 à #8 (index 4 à 7, ordre d'affichage) sont forcés en
// filière "hydroelectricite" pour montrer le changement de couleur de fond de la carte au scroll
// (bleu Hydro au lieu du orange Photovoltaïque par défaut) — aucun de ces projets n'est réellement
// hydroélectrique dans les données actuelles. À retirer dès que de vrais projets multi-filières
// seront disponibles ; energy garde sa vraie valeur, seul l'override d'affichage ci-dessous change.
const DEMO_HYDRO_OVERRIDE_INDICES = new Set([4, 5, 6, 7]);

const scrollMapItems = dedupedProjects.map((p, i) => {
  const themeKey = DEMO_HYDRO_OVERRIDE_INDICES.has(i) ? "hydroelectricite" : (ENERGY_TO_THEME[p.energy] ?? "photovoltaique");
  const theme = themes[themeKey];
  return {
    id: p.id,
    name: p.name,
    commune: p.commune,
    lat: p.lat,
    lng: p.lng,
    type: p.type,
    power: p.power,
    description: p.description,
    color: theme.color,
    energyKey: theme.key,
    energyLabel: theme.shortName,
  };
});

const THEME_PHOTOS: Record<string, Parameters<typeof photoUrl>[0]> = {
  hydroelectricite: "hydroHauteChute",
  photovoltaique: "pvAuSol",
  "flexibilite-bess": "bessTerrain",
  biogaz: "biogaz",
};

const showcaseItems = energyThemeList.map((theme) => ({
  key: theme.key,
  label: theme.name,
  tagline: theme.tagline,
  image: photoUrl(THEME_PHOTOS[theme.key], { w: 900 }),
  color: theme.colorDark,
  logo: theme.logo,
  href: theme.href,
}));

// 15 projets = exactement 3 rangées de 5 pour HeroParallax (bandeau "Vous souhaitez découvrir nos
// projets"). Pas de photo par site individuel dans les données actuelles (cf. photovoltaique.astro)
// : alterne toiture/ombrières selon le type du projet, cohérent avec les visuels déjà utilisés
// ailleurs sur le site plutôt que d'introduire une 3ᵉ source d'images.
const heroParallaxProducts = projects.map((p) => ({
  title: `${p.name} — ${p.commune}`,
  link: p.id === "star-soleil" ? "/projets/star-soleil" : "/photovoltaique",
  thumbnail: photoUrl(p.type.toLowerCase().includes("ombrières") ? "pvOmbrieres" : "pvToiture", { w: 900 }),
}));

const petalItems = energyThemeList.map((theme) => ({
  key: theme.key,
  label: theme.shortName,
  color: theme.color,
  href: theme.href,
}));

// Liste confirmée par le site actuel cayrolenergie.com (page Société) pour les 3 premières
// entrées (certifications réelles), complétée par les références du cadrage PDF (section "Ils
// nous font confiance" de l'onglet BESS). Volontairement pas de logos d'entreprises sans lien
// réel avec Cayrol Energie (Google, grandes marques...).
const trustedBy = [
  "QualiPV",
  "La French Tech Green",
  "La French Lab",
  "Banque Populaire",
  "Crédit Agricole",
  "CA des Savoie",
  "Territoire d'énergie Savoie Mont-Blanc",
  "Groupe Lauzière",
];

const totalPower = projects.reduce((sum, p) => {
  const match = p.power.match(/[\d.,]+/);
  return sum + (match ? parseFloat(match[0].replace(",", ".")) : 0);
}, 0);

const communes = new Set(projects.map((p) => p.commune)).size;

// target = valeur numérique animée en comptage, suffix = reste du texte affiché après le nombre.
const heroStats = [
  { target: projects.length, suffix: "+", label: "projets réalisés" },
  { target: Math.round(totalPower), suffix: "+ kVA", label: "de puissance installée" },
  { target: communes, suffix: "", label: "communes partenaires" },
  { target: 4, suffix: "", label: "filières énergétiques" },
];
---

<BaseLayout title="Accueil" theme="societe" transparentHeader>
  <!-- Hero plein écran : photo pleine page, header transparent fondu dedans, texte centré.
       Le titre se colore mot par mot au fil du scroll (gris → orange), fond figé (sticky) tant
       que la lecture n'est pas terminée — même principe que la section scroll-reveal étudiée sur
       business.nrg.com (fond pinned + texte qui se colore en fonction de la progression de
       scroll), adapté ici au titre du hero plutôt qu'à un déroulé en plusieurs phases. La section
       fait 200vh de haut : le texte finit de se colorer à HERO_COLOR_VH de scroll (voir script),
       puis le fond reste figé encore jusqu'à 100vh — pause volontaire avant que le sticky ne se
       libère, pour éviter que la page ne se mette à défiler juste au moment où le texte finit de
       se colorer (transition trop brusque sinon) — les 100vh suivants laissent le hero défiler
       normalement hors de l'écran une fois le texte entièrement coloré. -->
  <section id="hero-section" class="relative h-[200vh] w-full">
    <div class="sticky top-0 h-screen w-full overflow-hidden">
      <img
        src={photoUrl("heroAccueil", { w: 2400 })}
        alt="Vue aérienne d'une centrale photovoltaïque Cayrol Energie"
        class="absolute inset-0 h-full w-full object-cover"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-black/50 via-black/25 to-black/70" aria-hidden="true" />

      <!-- Motif de marque en filigrane, coin supérieur droit -->
      <BrandPattern
        id="brand-hero"
        color="white"
        class="pointer-events-none absolute -right-16 -top-16 h-72 w-72 opacity-5 md:h-96 md:w-96"
      />

      <!-- Texte, aligné à gauche, bien espacé -->
      <div class="relative z-10 flex h-screen flex-col justify-center gap-8 px-6 md:px-16 lg:px-24">
        <div class="max-w-2xl">
          <h1 id="hero-title" class="text-4xl font-extrabold leading-tight text-white drop-shadow-sm md:text-6xl">
            {"Des territoires et des Hommes au cœur de la transition énergétique.".split(" ").map((word) => (
              <span class="hero-word mr-[0.3em] inline-block" data-word>{word}</span>
            ))}
          </h1>
          <p class="mt-8 max-w-xl text-lg text-white/85 md:text-xl">
            Nous développons, construisons et exploitons des installations à taille humaine, en lien
            étroit avec nos territoires.
          </p>
        </div>
      </div>

      <!-- Repère de scroll -->
      <div class="absolute inset-x-0 bottom-6 z-10 flex justify-center md:bottom-8" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 animate-bounce opacity-70">
          <path d="M6 9l6 6 6-6" />
        </svg>
      </div>
    </div>
  </section>

  <style>
    /* Couleur de repos (avant lecture) : blanc légèrement translucide, cohérent avec le sous-titre
       — la variable --word-progress (0 à 1, posée en JS ci-dessous) pilote le mélange vers
       l'orange de marque au fil du scroll. */
    .hero-word {
      color: color-mix(in srgb, white calc(100% - var(--word-progress, 0) * 100%), #f97316 calc(var(--word-progress, 0) * 100%));
      transition: color 80ms linear;
    }
  </style>

  <script>
    // Colore le titre du hero mot par mot en fonction de la position de scroll dans la section
    // #hero-section (200vh) : les HERO_COLOR_VH premiers vh de scroll font progresser
    // --word-progress de chaque mot de 0 à 1, en cascade (le mot N atteint sa couleur pleine
    // légèrement avant N+1), pour un effet de lecture progressive plutôt qu'un bloc qui change
    // d'un coup. Volontairement < 1 (100vh, la distance réelle avant que le sticky ne se libère) :
    // laisse une pause figée entre la fin de la coloration et le début du défilement de la page,
    // plutôt qu'un enchaînement immédiat qui donnait l'impression que la page "partait" en même
    // temps que le texte finissait de se colorer.
    const HERO_COLOR_VH = 0.6;

    function initHeroColorReveal() {
      const section = document.getElementById("hero-section");
      const header = document.getElementById("site-header");
      const words = Array.from(document.querySelectorAll<HTMLElement>("#hero-title .hero-word"));
      if (!section || words.length === 0) return;

      // Header masqué par défaut au chargement de cette page (posé ici plutôt qu'en dur dans le
      // markup du header, pour ne rester spécifique qu'à l'accueil) — retiré une fois la lecture
      // du titre terminée.
      header?.classList.add("header-hidden");

      function onScroll() {
        if (!section) return;
        const rect = section.getBoundingClientRect();
        // progress = 0 en haut de la section, 1 une fois HERO_COLOR_VH consommés (donc avant que
        // le sticky ne se libère à 100vh, et bien avant que la section (200vh) n'ait fini de
        // défiler dans son ensemble).
        const scrolled = -rect.top;
        const progress = Math.min(Math.max(scrolled / (window.innerHeight * HERO_COLOR_VH), 0), 1);

        words.forEach((word, i) => {
          // Chaque mot occupe une tranche de la progression totale, avec un léger chevauchement
          // (overlap) entre mots consécutifs pour une transition douce plutôt qu'un pas-à-pas net.
          // wordEnd est explicitement clampé à 1 (Math.min) : sans ça, le dernier mot visait un
          // seuil > 1 jamais atteignable (puisque progress est lui-même plafonné à 1) et restait
          // bloqué à mi-course — la section se libérait avant que le texte soit fini de colorer.
          const wordStart = i / words.length;
          const wordEnd = Math.min((i + 1.6) / words.length, 1);
          const wordProgress = (progress - wordStart) / (wordEnd - wordStart);
          word.style.setProperty("--word-progress", String(Math.min(Math.max(wordProgress, 0), 1)));
        });

        header?.classList.toggle("header-hidden", progress < 1);
      }

      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });
    }

    document.addEventListener("astro:page-load", initHeroColorReveal);
  </script>

  <!-- Bandeau de stats : cartes bento sur fond clair, séparateurs verticaux visibles entre
       chaque chiffre — les chiffres comptent de 0 jusqu'à leur valeur au moment où ils entrent
       dans l'écran. -->
  <section class="relative overflow-hidden bg-slate-50">
    <BrandPattern
      id="brand-stats"
      color="#ea580c"
      class="pointer-events-none absolute -right-10 -top-10 h-64 w-64 opacity-5"
    />
    <div class="relative mx-auto max-w-6xl px-4 py-10 md:px-8">
      <div class="grid grid-cols-2 rounded-xl border border-slate-300 bg-white shadow-sm md:grid-cols-4">
        {heroStats.map((s, i) => (
          <div
            class:list={[
              "px-6 py-6 text-center",
              i % 2 === 0 && "border-r border-slate-200",
              i < heroStats.length - 1 && "md:border-r",
              i >= 2 && "border-t border-slate-200 md:border-t-0",
            ]}
          >
            <p
              class="stat-number text-3xl font-extrabold text-slate-900 md:text-4xl"
              data-target={s.target}
              data-suffix={s.suffix}
            >
              {s.target}{s.suffix}
            </p>
            <p class="mt-1 text-xs uppercase tracking-wide text-slate-500 md:text-sm">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <script>
    // Compteur animé : déclenché une fois par élément quand le bandeau de stats entre dans
    // l'écran. Réexécuté à chaque navigation (y compris le premier chargement) via
    // astro:page-load pour rester compatible avec les transitions de page (ClientRouter).
    let statsObserver: IntersectionObserver | null = null;

    function animateStat(el: HTMLElement) {
      const target = Number(el.dataset.target ?? "0");
      const suffix = el.dataset.suffix ?? "";
      const duration = 1400;
      const start = performance.now();

      function tick(now: number) {
        const t = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - t, 3); // easeOutCubic
        const current = Math.round(target * eased);
        el.textContent = `${current}${suffix}`;
        if (t < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }

    function initStatCounters() {
      statsObserver?.disconnect();

      const stats = document.querySelectorAll<HTMLElement>(".stat-number");
      if (stats.length === 0) return;

      statsObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              animateStat(entry.target as HTMLElement);
              statsObserver?.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.4 }
      );

      stats.forEach((el) => statsObserver?.observe(el));
    }

    document.addEventListener("astro:page-load", initStatCounters);
  </script>

  <!-- Nos filières, variante B — timeline + cartes empilées façon tuta.com/fr, posée juste
       au-dessus de la version grille pour comparer les deux avant de trancher. Fond teinté
       (orange très clair, couleur de marque) plutôt que blanc plat : premier maillon d'un rythme
       de couleur plus marqué sur la page (cf. bandeau CTA plein orange plus bas). -->
  <section class="relative overflow-hidden border-t border-slate-200/80 bg-orange-50/60">
    <div class="relative mx-auto max-w-6xl px-4 py-20 md:py-28">
      <h2 class="mb-3 text-3xl font-bold text-neutral-900 md:text-4xl">Nos filières d'expertise (variante B)</h2>
      <p class="mb-14 text-lg text-neutral-600">Quatre énergies, une même exigence de qualité et d'ancrage local.</p>
      <EnergyShowcase client:visible items={showcaseItems} />
    </div>
  </section>

  <!-- Sélection des univers énergétiques : hero secondaire clair avec grille de points en fond
       (variante grille "expanding cards", via ThemeSelector) — mise de côté au profit de la
       variante B (EnergyShowcase, timeline + cartes empilées) juste au-dessus, gardée en commentaire
       plutôt que supprimée le temps de confirmer que la variante B est bien celle qu'on garde. -->
  <!--
  <section class="bg-dot-grid border-t border-slate-200/80 bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <h2 class="mb-2 text-2xl font-bold text-neutral-900">Nos filières d'expertise</h2>
      <p class="mb-8 text-neutral-600">Quatre énergies, une même exigence de qualité et d'ancrage local.</p>
      <ThemeSelector client:visible />
    </div>
  </section>
  -->

  <!-- Bandeau d'accroche en couleur pleine : rompt franchement le rythme clair/blanc de la page,
       plutôt qu'une nuance de plus — sert aussi de transition entre "nos filières" et "nos
       implantations" avec un vrai temps fort visuel. Le pictogramme blanc officiel sert de
       filigrane fixe en arrière-plan (grand, semi-transparent, à droite) — pas d'animation liée
       au scroll : le texte reste pleinement lisible en toutes circonstances, contrairement aux
       essais précédents (roue qui roule, puis rideau qui glisse) où le logo pouvait masquer le
       message ou disparaître trop vite selon la vitesse de défilement. -->
  <section id="wheel-banner" class="relative overflow-hidden bg-orange-600 py-16 text-center">
    <img
      src="/logos/sigle-negatif-T-removebg-preview.png"
      alt=""
      aria-hidden="true"
      class="pointer-events-none absolute inset-y-0 right-0 z-0 h-full w-auto max-w-[45%] object-contain opacity-15 md:max-w-[35%]"
    />

    <div class="relative z-10 mx-auto max-w-3xl px-4">
      <p class="text-2xl font-extrabold text-white md:text-3xl">
        15 centrales, 4 filières, une même exigence de proximité.
      </p>
      <p class="mt-3 text-orange-50">
        Découvrez où nous intervenons et comment nous accompagnons chaque territoire.
      </p>
    </div>
  </section>

  <!-- Bandeau d'accroche "Vous souhaitez découvrir nos projets" : pattern "Hero Parallax"
       (3 rangées de projets qui défilent horizontalement en sens opposés pendant que la scène
       pivote en 3D au scroll), remplace le précédent essai ContainerScroll — jugé redondant une
       fois rempli de la mosaïque des 4 filières, déjà montrées juste au-dessus (EnergyShowcase).
       ContainerScroll et FilieresMosaic restent disponibles (imports conservés) pour un usage
       ailleurs sur le site (pages métier notamment). L'exploration cartographique vit toujours
       entièrement dans ScrollProjectMap juste en dessous (id="scroll-project-map"). -->
  <section class="border-t border-slate-200/80 bg-slate-50">
    <HeroParallax
      client:visible
      title="Vous souhaitez découvrir nos projets ?"
      description="15 réalisations, région par région — faites défiler pour explorer, ou suivez le fil jusqu'à la carte."
      products={heroParallaxProducts}
    />
  </section>

  <!-- Nos implantations, variante scrollytelling façon featured.undp.org/digital-goals : carte
       figée à gauche, projets qui défilent en texte à droite, un seul point actif à la fois.
       id="scroll-project-map" ciblé par le bouton "Voir la carte" du bandeau ScrollDrawnPath
       juste au-dessus. -->
  <section id="scroll-project-map" class="scroll-mt-24 border-t border-slate-200/80 bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <h2 class="mb-2 text-2xl font-bold text-neutral-900">Nos implantations en France (variante scroll)</h2>
      <p class="mb-10 text-neutral-600">Faites défiler pour découvrir nos réalisations, région par région.</p>
      <ScrollProjectMap client:visible items={scrollMapItems} />
    </div>
  </section>

  <!-- Autoconsommation collective -->
  <section class="border-t border-slate-200/80" style="background-color: var(--theme-color-bg, #f0f9ff);">
    <div class="mx-auto flex max-w-6xl flex-col items-start gap-6 px-4 py-14 md:flex-row md:items-center">
      <img src="/logos/logo-assoc.png" alt="Court Circuit" class="h-24 w-24 shrink-0 object-contain" />
      <div>
        <h2 class="mb-2 text-2xl font-bold text-sky-900">Autoconsommation collective</h2>
        <p class="max-w-2xl text-neutral-700">
          Avec l'association Court Circuit, Cayrol Energie accompagne les habitants et entreprises d'un même
          territoire pour consommer localement l'électricité produite près de chez eux, en toute transparence.
        </p>
        <a
          href="/autoconsommation-collective"
          class="mt-4 inline-block rounded-full bg-sky-600 px-5 py-2 text-sm font-semibold text-white transition hover:bg-sky-700"
        >
          Découvrir Court Circuit
        </a>
      </div>
    </div>
  </section>

  <!-- Arc de pétales du logo, repris comme sélecteur de filières — premier essai pour explorer
       comment réutiliser un élément de la marque ailleurs que dans le header. Cliquer un pétale
       l'agrandit et le fait légèrement pivoter avant de naviguer vers sa page filière. -->
  <section class="border-t border-slate-200/80 bg-white py-16">
    <div class="mx-auto max-w-6xl px-4 text-center">
      <h2 class="mb-2 text-2xl font-bold text-neutral-900">Nos filières, en un coup d'œil</h2>
      <p class="mb-10 text-neutral-600">Cliquez sur un pétale pour découvrir la filière.</p>
      <PetalArc client:visible items={petalItems} />
    </div>
  </section>

  <!-- Ils nous font confiance : bandeau à défilement infini, pure CSS -->
  <section class="border-t border-slate-200/80 bg-white py-12">
    <h2 class="mb-8 text-center text-sm font-semibold uppercase tracking-widest text-neutral-400">
      Ils nous font confiance
    </h2>
    <LogoMarquee items={trustedBy} />
  </section>
</BaseLayout>
